# Dependencies (matches node_modules in any folder: Frontend/, Backend/, ...)
node_modules/

# Build output
dist/
dist-ssr/
build/
coverage/

# Prisma generated client (regenerate with `npm run db:generate`)
Backend/generated/

# Environment files — never commit secrets
.env
.env.*
!.env.example
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors and OS files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.suo
*.sw?

# Claude Code local settings
.claude/settings.local.json
