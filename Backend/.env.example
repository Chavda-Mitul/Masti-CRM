# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=5000

# PostgreSQL connection
DATABASE_URL="postgresql://masti:change-me@localhost:5432/masti_crm"

# Local dev database (docker-compose.yml) — must match DATABASE_URL
POSTGRES_USER=masti
POSTGRES_PASSWORD=change-me
POSTGRES_DB=masti_crm
POSTGRES_PORT=5432

# Frontend origin(s) allowed by CORS, comma-separated
CLIENT_URL=http://localhost:5173

# Behind a reverse proxy (nginx) in production: the hop count ("1" for one nginx) or the proxy IPs/subnets, comma-separated,
# so req.ip is the real client IP (office-network rule, login limits, audit log). "false" only with no proxy.
# "true" is refused: it trusts an X-Forwarded-For header any browser can fake.
TRUST_PROXY=false

# Sessions: end after this many idle hours, and always after SESSION_MAX_DAYS
SESSION_IDLE_HOURS=12
SESSION_MAX_DAYS=7
# A login with a temporary password must set a new password within this many minutes, or log in again
TEMP_PASSWORD_SESSION_MINUTES=15
# Session cookie over HTTPS only: auto (= production only), true or false.
# Use false only if the CRM is served over plain HTTP; with a secure cookie on plain HTTP, login silently fails.
COOKIE_SECURE=auto

# First Head user, created by `npm run db:seed` (mobile and/or email). Leave the password empty to get a temporary one.
SEED_HEAD_NAME=Vimal
SEED_HEAD_MOBILE=
SEED_HEAD_EMAIL=
SEED_HEAD_PASSWORD=

# Document storage (CLAUDE.md rule 4): S3-compatible. Locally MinIO from docker-compose.yml; in production AWS S3 or
# Cloudflare R2 (then leave S3_ENDPOINT empty for AWS, or set R2's endpoint). Files are private; links are pre-signed.
# Not read by the code yet: uploading scans comes after Visa Step 2.
MINIO_ROOT_USER=masti-minio
MINIO_ROOT_PASSWORD=change-me-too
MINIO_PORT=9000
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=masti-crm-documents
# Locally the MinIO root user; in production an access key limited to this bucket.
S3_ACCESS_KEY_ID=masti-minio
S3_SECRET_ACCESS_KEY=change-me-too
# MinIO needs path-style URLs (http://localhost:9000/bucket/key); AWS and R2 work either way.
S3_FORCE_PATH_STYLE=true
# How long a shared link works, in seconds.
S3_PRESIGN_SECONDS=300
