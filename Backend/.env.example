# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=5000

# PostgreSQL connection
DATABASE_URL="postgresql://masti:change-me@localhost:5432/masti_crm"

# Local dev database (docker-compose.yml) — must match DATABASE_URL
POSTGRES_USER=masti
POSTGRES_PASSWORD=change-me
POSTGRES_DB=masti_crm
POSTGRES_PORT=5432

# Frontend origin(s) allowed by CORS, comma-separated
CLIENT_URL=http://localhost:5173
# The address clients open links on (the consent form, docs/decisions/0022-consent-form.md). Masti's own https address in
# production. A phone can't open localhost: test the link on the laptop, or use the laptop's LAN address with `vite --host`.
# WhatsApp's provider also fetches a message's file there (0025, part 2): in production it must be reachable from the
# internet. On a laptop Twilio can't reach it, so a message with a file fails there unless this is a tunnel's address.
PUBLIC_APP_URL=http://localhost:5173

# Behind a reverse proxy (nginx) in production: the hop count ("1" for one nginx) or the proxy IPs/subnets, comma-separated,
# so req.ip is the real client IP (office-network rule, login limits, audit log). "false" only with no proxy.
# "true" is refused: it trusts an X-Forwarded-For header any browser can fake.
TRUST_PROXY=false

# Sessions: end after this many idle hours, and always after SESSION_MAX_DAYS
SESSION_IDLE_HOURS=12
SESSION_MAX_DAYS=7
# A login with a temporary password must set a new password within this many minutes, or log in again
TEMP_PASSWORD_SESSION_MINUTES=15
# Session cookie over HTTPS only: auto (= production only), true or false.
# Use false only if the CRM is served over plain HTTP; with a secure cookie on plain HTTP, login silently fails.
COOKIE_SECURE=auto

# First Head user, created by `npm run db:seed` (mobile and/or email). Leave the password empty to get a temporary one.
SEED_HEAD_NAME=Vimal
SEED_HEAD_MOBILE=
SEED_HEAD_EMAIL=
SEED_HEAD_PASSWORD=

# Document storage (CLAUDE.md rule 4): S3-compatible. Locally MinIO from docker-compose.yml; in production AWS S3 or
# Cloudflare R2 (then leave S3_ENDPOINT empty for AWS, or set R2's endpoint). Files are private; links are pre-signed.
# First used for the visa file (docs/decisions/0007-visa-file-prep.md Decision 8). Pre-signed links point at
# S3_ENDPOINT, so staff browsers must be able to reach it (not a name that only resolves inside docker).
MINIO_ROOT_USER=masti-minio
MINIO_ROOT_PASSWORD=change-me-too
MINIO_PORT=9000
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=masti-crm-documents
# Locally the MinIO root user; in production an access key limited to this bucket.
S3_ACCESS_KEY_ID=masti-minio
S3_SECRET_ACCESS_KEY=change-me-too
# MinIO needs path-style URLs (http://localhost:9000/bucket/key); AWS and R2 work either way.
S3_FORCE_PATH_STYLE=true
# How long a shared link works, in seconds (30–3600). ⚠️ 5 minutes.
S3_PRESIGN_SECONDS=300

# Outgoing email (the dispatch email to the vendor, docs/decisions/0008-visa-docket-dispatch.md Decision 8). Locally
# Mailpit from docker-compose.yml catches everything (read it at http://localhost:8025); nothing leaves the machine.
# In production, Masti's own SMTP account (A6): SMTP_SECURE=true for port 465, false for STARTTLS on 587.
# Leave SMTP_HOST empty and nothing is sent: the Dispatch card shows "Email isn't set up yet" with Send again.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="MASTI TOUR AND TRAVEL <crm@example.com>"

# WhatsApp to clients (docs/decisions/0020-whatsapp-sending.md). WHATSAPP_PROVIDER: off (nothing is sent), log (each
# message goes into the server log instead, for a laptop) or twilio. Check it with: npm run whatsapp:test -- <mobile>
# Twilio while we build: its sandbox. In the Twilio Console open Messaging → WhatsApp → Try out WhatsApp, send the join
# message from your phone, then copy the Account SID and Auth Token from Account Info. Tests never send (vitest.config.mts).
WHATSAPP_PROVIDER=off
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The number messages come from, with + and the country code. Twilio's sandbox: +14155238886
TWILIO_WHATSAPP_FROM=
# Outside production every client message goes to this phone instead of the client's (docs/decisions/0021-whatsapp-outbox.md):
# yours, joined to the sandbox. Needed outside production when WHATSAPP_PROVIDER=twilio; must be empty in production.
WHATSAPP_TEST_NUMBER=

# AI (docs/decisions/0023-ai.md), through src/lib/ai only. AI_PROVIDER: off (no AI), fake (a fixed answer, for a
# laptop with no key) or anthropic. Check it with: npm run ai:test
# The key: console.anthropic.com → Settings → Workspaces → create one (e.g. "Masti CRM") → API keys → Create key. A key
# Tests never call the AI (vitest.config.mts).
AI_PROVIDER=off
# The one model every AI use runs on. src/lib/ai/prices.ts must know its price, or calls are recorded with no cost.
AI_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=
# Only for a user key (sk-ant-usr-…), which belongs to no workspace and is refused without one: the workspace to
# bill, from Settings → Workspaces (wrkspc_…). Leave it empty for a key made inside a workspace (sk-ant-api…).
ANTHROPIC_WORKSPACE_ID=

# Server log (docs/decisions/0010-server-logs.md): one file a day in LOG_DIR, relative to Backend/ or absolute. Keeps the
# last LOG_RETENTION_DAYS days plus today's file. LOG_LEVEL: fatal, error, warn, info, debug or trace.
LOG_LEVEL=info
LOG_DIR=logs
LOG_RETENTION_DAYS=90

# Portal logins, "Log in for me" (docs/decisions/0024-portal-logins.md). PORTAL_VAULT_KEY locks every saved portal ID
# and password: 32 random bytes in base64, made with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Production refuses to start without it. Keep a copy apart from the database backups, and never change it once logins
# are saved: they can't be read with another key. Left empty locally, Settings → Portal logins says it isn't set up.
PORTAL_VAULT_KEY=
# The CRM helper's Chrome extension ID(s), comma-separated: only the helper may collect a login. The development helper
# (the key in Helper/manifest.json) is cbgfmlcnmcldkginifhpfcgpgfclmhfg.
PORTAL_HELPER_IDS=cbgfmlcnmcldkginifhpfcgpgfclmhfg
