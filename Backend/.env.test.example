# Copy to .env.test. `npm test` creates and migrates this database automatically.
# It is wiped before every test — never point it at real data.
DATABASE_URL="postgresql://masti:change-me@localhost:5432/masti_crm_test"

# The document bucket the tests use, on the MinIO from `npm run db:up` (address and keys come from .env). Created if
# missing and emptied at the start of every run, so its name must contain "test". Defaults to masti-crm-test.
S3_BUCKET="masti-crm-test"

# Tests send email to Mailpit from `npm run db:up` (localhost:1025, read back on http://localhost:8025) and clear it at
# the start of every run. These are the defaults; the tests refuse any SMTP_HOST other than localhost.
# SMTP_HOST="localhost"
# SMTP_PORT="1025"
# MAILPIT_URL="http://localhost:8025"
