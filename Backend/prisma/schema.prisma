generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Departments, users and roles
// ---------------------------------------------------------------------------

/// Rows, not an enum, so Phase-2 departments (Transport, Cruise) can be added without a migration.
model Department {
  id                Int                          @id @default(autoincrement())
  code              String                       @unique
  name              String
  /// Case numbers are {casePrefix}-{YYYY}-{NNNN} (VISA-2026-0001). Data, not code (§17 #21).
  casePrefix        String                       @unique
  sortOrder         Int                          @default(0)
  isActive          Boolean                      @default(true)
  createdAt         DateTime                     @default(now()) @db.Timestamptz(3)
  members           UserDepartment[]
  fieldJobs         FieldJob[]
  stages            DepartmentStage[]
  caseCounters      CaseCounter[]
  enquiries         Enquiry[]
  notices           Notice[]
  portalLogins      PortalLogin[]
  /// The follow-up and reason dropdown values shown in this department (0018).
  followUpOutcomes  FollowUpOutcomeDepartment[]
  followUpNextSteps FollowUpNextStepDepartment[]
  enquiryReasons    EnquiryReasonDepartment[]
}

/// What kind of account this is. It decides which app the user can open.
/// An enum, not a master table: each value is wired to code (guards, routes), so a new one needs a deploy anyway.
enum UserType {
  /// Vimal-level: every department, desktop CRM.
  HEAD
  /// Desktop CRM. Access comes only from UserDepartment rows.
  OFFICE
  /// Collection/delivery boy: the /tasks phone view only. Never has UserDepartment rows.
  FIELD
}

enum DepartmentRole {
  STAFF
  HOD
}

enum Access {
  VIEW
  EDIT
}

model User {
  id                    String                  @id @default(uuid())
  name                  String
  /// Stored normalised as +91XXXXXXXXXX. A user needs a mobile, an email, or both. FIELD users need a mobile.
  mobile                String?                 @unique
  /// Stored lowercased.
  email                 String?                 @unique
  passwordHash          String
  type                  UserType                @default(OFFICE)
  isActive              Boolean                 @default(true)
  mustChangePassword    Boolean                 @default(true)
  lastLoginAt           DateTime?               @db.Timestamptz(3)
  /// The visa team's login popup (docs/decisions/0017-today-dashboard.md Decision 12): dismissed up to this time; anything
  /// picked or added to the calendar after it is new to them. Null: everything is new.
  loginPopupSeenAt      DateTime?               @db.Timestamptz(3)
  createdAt             DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                @updatedAt @db.Timestamptz(3)
  departments           UserDepartment[]
  sessions              Session[]
  auditEntries          AuditLog[]
  assignedFieldJobs     FieldJob[]              @relation("FieldJobAssignee")
  fieldJobsBooked       FieldJob[]              @relation("FieldJobBookedBy")
  fieldJobsCancelled    FieldJob[]              @relation("FieldJobCancelledBy")
  clientsCreated        Client[]                @relation("ClientCreatedBy")
  clientPhonesAdded     ClientPhone[]           @relation("ClientPhoneCreatedBy")
  clientMembersAdded    ClientMember[]          @relation("ClientMemberCreatedBy")
  consentDetailsFilled  ClientMember[]          @relation("ClientMemberConsentDetailsBy")
  consentLinksSent      ConsentLink[]           @relation("ConsentLinkCreatedBy")
  consentWordingsAdded  ConsentWording[]        @relation("ConsentWordingAddedBy")
  consentsMarked        Consent[]               @relation("ConsentMarkedBy")
  clientNotes           ClientNote[]            @relation("ClientNoteAuthor")
  holidaysAdded         Holiday[]               @relation("HolidayAddedBy")
  enquiriesOwned        Enquiry[]               @relation("EnquiryOwner")
  enquiriesCreated      Enquiry[]               @relation("EnquiryCreatedBy")
  documentsReceived     VisaCaseDocument[]      @relation("DocumentReceivedBy")
  documentsChecked      VisaCaseDocument[]      @relation("DocumentCheckedBy")
  followUpsLogged       FollowUp[]              @relation("FollowUpBy")
  visaCasesMatured      VisaCase[]              @relation("VisaCaseMaturedBy")
  visaCasesFileReady    VisaCase[]              @relation("VisaCaseFileReadyBy")
  visaCasesOnline       VisaCase[]              @relation("VisaCaseSubmittedOnlineBy")
  visaCasesReceived     VisaCase[]              @relation("VisaCaseVendorReceivedBy")
  visaCasesSubmitted    VisaCase[]              @relation("VisaCaseSubmittedBy")
  visaCasesRecalled     VisaCase[]              @relation("VisaCaseRecalledBy")
  visaCasesDecided      VisaCase[]              @relation("VisaCaseDecidedBy")
  visaCasesInTransit    VisaCase[]              @relation("VisaCasePassportsInTransitBy")
  visaCasesReceivedBack VisaCase[]              @relation("VisaCasePassportsReceivedBy")
  visaEvisasSent        VisaCase[]              @relation("VisaCaseEvisaSentBy")
  visaShortfallsCleared VisaCase[]              @relation("VisaCaseShortfallClearedBy")
  visaHandovers         VisaHandover[]          @relation("VisaHandoverBy")
  caseFilesUploaded     CaseFile[]              @relation("CaseFileUploadedBy")
  clientDocsUploaded    ClientDocument[]        @relation("ClientDocumentUploadedBy")
  docketsCreated        Docket[]                @relation("DocketCreatedBy")
  docketsDispatched     Docket[]                @relation("DocketDispatchedBy")
  quotesUpdated         VisaQuote[]             @relation("VisaQuoteUpdatedBy")
  companyImagesAdded    CompanyImage[]          @relation("CompanyImageUploadedBy")
  invoicesIssued        Invoice[]               @relation("InvoiceIssuedBy")
  creditNotesIssued     CreditNote[]            @relation("CreditNoteIssuedBy")
  noticesPosted         Notice[]                @relation("NoticePostedBy")
  noticesPicked         Notice[]                @relation("NoticePickedBy")
  coveringLettersAdded  CoveringLetterVersion[] @relation("CoveringLetterVersionAddedBy")
  coveringLettersMade   VisaCase[]              @relation("VisaCaseCoveringLetterMadeBy")
  aiCalls               AiCall[]                @relation("AiCallBy")
  portalLoginsAdded     PortalLogin[]           @relation("PortalLoginCreatedBy")
  portalLogins          PortalLoginUser[]       @relation("PortalLoginUsers")
  portalLoginUses       PortalLoginUse[]        @relation("PortalLoginUsedBy")
  unseenAssignments     UnseenAssignment[]      @relation("UnseenAssignmentUser")

  @@index([type, isActive])
}

/// Only OFFICE users have rows here.
model UserDepartment {
  userId       String
  departmentId Int
  role         DepartmentRole @default(STAFF)
  access       Access         @default(VIEW)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department     @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@id([userId, departmentId])
  @@index([departmentId])
}

// ---------------------------------------------------------------------------
// Field jobs (collection/delivery boy's stops)
// ---------------------------------------------------------------------------

/// A field worker sees the jobs assigned to them, whatever department raised them.
/// What a field job is (docs/decisions/0015-field-staff-app.md): picking a case's documents up from the client, or
/// delivering its passports. Fixed in code: the screens and the rules branch on it. (Collecting money comes with
/// Accounts.)
enum FieldJobKind {
  PICKUP
  DELIVERY
}

/// Where a field job stands (0015): booked; done at the door; failed (a reason from a list, phase 4); or called off by
/// the office.
enum FieldJobStatus {
  BOOKED
  DONE
  FAILED
  CANCELLED
}

/// A time slot the boy is booked for (0015 Decision 2): a list the Head or an HOD edits, seeded with the demo's ⚠️.
/// Times are IST, "HH:mm", ending after they start (checked in the migration). Switched off, never deleted.
model FieldSlot {
  id        Int        @id @default(autoincrement())
  code      String     @unique
  /// "4–6 pm"
  name      String
  startsAt  String
  endsAt    String
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  jobs      FieldJob[]
}

/// Why a visit failed (0015 Decision 5): a list the Head or an HOD edits, seeded with the demo's ⚠️ and "Client
/// couldn't get the code" (no code, no pickup: decided 17 Oct 2026). Switched off, never deleted, so a failed job keeps
/// its reason.
model FieldFailReason {
  id        Int        @id @default(autoincrement())
  /// CLIENT_NOT_HOME… Never changes.
  code      String     @unique
  name      String
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  jobs      FieldJob[]
}

/// One stop on the boy's run (0002, 0015): which desk raised it, for which case, who goes, on which day and slot, where
/// to (the client's address, copied at booking and correctable, with an optional Google Maps link) and the client's
/// mobile for his Call button. One booked job of each kind per case, kept by the case lock. Cancelled: who and when,
/// together. Finished (done, or couldn't complete with a reason, phase 4): when, and the place his phone gave. All
/// checked in the migration.
model FieldJob {
  id              String           @id @default(uuid())
  /// The desk that raised it (Visa, Accounts…), for its lists and reports.
  departmentId    Int
  kind            FieldJobKind
  status          FieldJobStatus   @default(BOOKED)
  enquiryId       String
  /// An active FIELD user when booked (the service checks).
  assigneeId      String
  day             DateTime         @db.Date
  slotId          Int
  address         String
  /// The client's location in Google Maps, when they shared one (0015 Decision 3).
  mapLink         String?
  mobile          String
  createdById     String
  cancelledAt     DateTime?        @db.Timestamptz(3)
  cancelledById   String?
  /// When he recorded it done or couldn't complete (0015 phase 4), with the place his phone gave (golden rule 5):
  /// degrees, and the accuracy in whole metres. All four together, on a finished job only.
  finishedAt      DateTime?        @db.Timestamptz(3)
  latitude        Float?
  longitude       Float?
  accuracyM       Int?
  /// Why he couldn't complete it (0015 Decision 5): set exactly when FAILED.
  failReasonId    Int?
  /// What he recorded at the door when it's DONE (Decision 4), and only then: the booklets he counted (at a pickup they
  /// become the case's intake count) and his selfie, a case file of its own.
  bookletsCurrent Int?             @db.SmallInt
  bookletsOld     Int?             @db.SmallInt
  selfieId        String?          @unique
  /// The client's one-time code (Decision 4): only its hash (sha256 of the job and the code), when and where it went,
  /// until when it works, the wrong tries, and when the client confirmed it. Cleared again if the email didn't go.
  otpHash         String?
  otpSentAt       DateTime?        @db.Timestamptz(3)
  otpSentTo       String?
  otpExpiresAt    DateTime?        @db.Timestamptz(3)
  otpTries        Int              @default(0) @db.SmallInt
  otpConfirmedAt  DateTime?        @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  department      Department       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  enquiry         Enquiry          @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  assignee        User             @relation("FieldJobAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  slot            FieldSlot        @relation(fields: [slotId], references: [id], onDelete: Restrict)
  createdBy       User             @relation("FieldJobBookedBy", fields: [createdById], references: [id], onDelete: Restrict)
  cancelledBy     User?            @relation("FieldJobCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  failReason      FieldFailReason? @relation(fields: [failReasonId], references: [id], onDelete: Restrict)
  selfie          CaseFile?        @relation("FieldJobSelfie", fields: [selfieId], references: [id], onDelete: Restrict)
  /// The handover a delivery done at the door made (phase 5).
  handover        VisaHandover?

  @@index([assigneeId, day])
  @@index([enquiryId])
  @@index([departmentId])
}

// ---------------------------------------------------------------------------
// Sessions (server-side, so deactivating a user ends access immediately)
// ---------------------------------------------------------------------------

model Session {
  id         String   @id @default(uuid())
  /// SHA-256 of the cookie token. The raw token is never stored.
  tokenHash  String   @unique
  userId     String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime @db.Timestamptz(3)
  ip         String?
  userAgent  String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Audit log (append-only: a database trigger blocks UPDATE and DELETE)
// ---------------------------------------------------------------------------

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  /// The client the change belongs to (the client, its numbers, members, notes, documents), so a client's
  /// history is one indexed query. No foreign key: audit rows must never block or follow changes to other tables.
  clientId   String?
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([clientId, createdAt])
  @@index([actorId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Client master: lookup tables (seeded; admin screens come with System Masters).
// See docs/decisions/0004-client-master.md.
// ---------------------------------------------------------------------------

/// Weekly / half-monthly / monthly ✅, default monthly ✅. Rows, because billing cycles are a master (§7 rule 9).
model BillingCycle {
  id        Int      @id @default(autoincrement())
  /// WEEKLY, HALF_MONTHLY, MONTHLY
  code      String   @unique
  name      String
  /// At most one row is the default (partial unique index in the migration). New clients get it.
  isDefault Boolean  @default(false)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  clients   Client[]
}

/// "Pays: Part advance, rest on delivery". Demo values ⚠️.
model PaymentHabit {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  clients   Client[]
}

/// Self, Spouse, Son, Daughter… and Employee for corporate clients.
model Relation {
  id        Int            @id @default(autoincrement())
  code      String         @unique
  name      String
  sortOrder Int            @default(0)
  isActive  Boolean        @default(true)
  members   ClientMember[]
}

// ---------------------------------------------------------------------------
// Clients
// ---------------------------------------------------------------------------

/// Code branches on it (contact person, readiness rules per kind), so an enum.
enum ClientKind {
  INDIVIDUAL
  CORPORATE
}

/// Saved against the mobile number ✅: an enquiry needs only that.
/// Completed before invoicing; which fields are required is the clients.invoiceReadiness setting.
/// Never deleted: enquiries and invoices will point here.
model Client {
  id             String            @id @default(uuid())
  kind           ClientKind        @default(INDIVIDUAL)
  /// +91XXXXXXXXXX. The lookup key, the WhatsApp number, and the match key for the Excel import.
  mobile         String            @unique
  /// The person's name, or the company's. Required (0004 Amendment); a database check also refuses a blank one.
  /// Integrations and the Excel import must supply one too (e.g. the WhatsApp profile name).
  name           String
  /// CORPORATE only (database check): the person we deal with.
  contactPerson  String?
  /// Stored lowercased.
  email          String?
  addressLine    String?
  /// "Vesu"
  area           String?
  city           String?
  /// GST state code ("24" = Gujarat). Decides the place of supply on invoices.
  stateCode      String?           @db.Char(2)
  pincode        String?           @db.Char(6)
  /// Uppercase AAAAA9999A. Typed in by staff; not verified (PAN verification is Q23, out of scope).
  pan            String?
  /// Uppercase, 15 characters. Characters 3–12 equal pan when both are set (database check).
  gstin          String?
  /// The client's code in Masti's accounting software ✅.
  accountingCode String?           @unique
  billingCycleId Int
  paymentHabitId Int?
  /// The service sets the IST date; the Excel import may set an earlier one. The default is today in India too.
  clientSince    DateTime          @default(dbgenerated("(timezone('Asia/Kolkata'::text, now()))::date")) @db.Date
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  /// Also the optimistic-lock token: PATCH sends back the updatedAt it read.
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)
  /// Null when created by the WhatsApp bot, a website form or the import.
  createdById    String?
  billingCycle   BillingCycle      @relation(fields: [billingCycleId], references: [id], onDelete: Restrict)
  paymentHabit   PaymentHabit?     @relation(fields: [paymentHabitId], references: [id], onDelete: Restrict)
  createdBy      User?             @relation("ClientCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  phones         ClientPhone[]
  members        ClientMember[]
  notes          ClientNote[]
  documents      ClientDocument[]
  enquiries      Enquiry[]
  /// What the CRM has sent them (docs/decisions/0021-whatsapp-outbox.md).
  messages       OutboundMessage[]

  @@index([name])
  @@index([pan])
  @@index([gstin])
  // Trigram indexes (pg_trgm, created in the migration) for the "any part of the name/number" search.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Client_name_trgm_idx")
  @@index([contactPerson(ops: raw("gin_trgm_ops"))], type: Gin, map: "Client_contactPerson_trgm_idx")
  @@index([mobile(ops: raw("gin_trgm_ops"))], type: Gin, map: "Client_mobile_trgm_idx")
}

/// Extra numbers. Lookup matches them too; WhatsApp always goes to Client.mobile.
/// Not unique across clients (an office accountant's number can sit on two clients): a match is a warning staff confirm.
model ClientPhone {
  id          String   @id @default(uuid())
  clientId    String
  /// +91XXXXXXXXXX
  mobile      String
  /// "Office", "Wife's number". Display only; never reported on.
  label       String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  createdById String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdBy   User     @relation("ClientPhoneCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([clientId, mobile])
  @@index([mobile])
  @@index([mobile(ops: raw("gin_trgm_ops"))], type: Gin, map: "ClientPhone_mobile_trgm_idx")
}

/// Family & travellers ✅ (or a corporate's employees). Visa Step 2 links case travellers to these rows.
/// Consent is its own model (one per person for life, keyed to the member, not the passport): see Consent.
model ClientMember {
  id                 String              @id @default(uuid())
  clientId           String
  /// As printed in the passport, once seen.
  name               String
  relationId         Int
  /// Age ("Son, 12") is worked out from this.
  dateOfBirth        DateTime?           @db.Date
  mobile             String?
  /// Current passport only. Uppercase, no spaces. Not unique: a duplicate is a warning staff confirm.
  /// Earlier numbers stay in the audit log.
  passportNumber     String?
  passportExpiry     DateTime?           @db.Date
  sortOrder          Int                 @default(0)
  /// Taken off the family list. Never deleted: past cases will point here.
  archivedAt         DateTime?           @db.Timestamptz(3)
  // The consent form's details (docs/decisions/0022-consent-form.md): staff fill them in by asking the client, for
  // life; the consent the client agrees to keeps a copy of them as they were. Checks in the migration: no blank
  // text, income not negative, consentDetailsAt and consentDetailsById set together.
  spouseDateOfBirth  DateTime?           @db.Date
  anniversary        DateTime?           @db.Date
  motherDateOfBirth  DateTime?           @db.Date
  fatherDateOfBirth  DateTime?           @db.Date
  residentialAddress String?
  officeAddress      String?
  /// A year, in whole rupees.
  annualIncome       Int?
  profession         String?
  education          String?
  /// When staff last saved the form, and who.
  consentDetailsAt   DateTime?           @db.Timestamptz(3)
  consentDetailsById String?
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  /// Optimistic-lock token, as on Client.
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  createdById        String
  client             Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  relation           Relation            @relation(fields: [relationId], references: [id], onDelete: Restrict)
  createdBy          User                @relation("ClientMemberCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  consentDetailsBy   User?               @relation("ClientMemberConsentDetailsBy", fields: [consentDetailsById], references: [id], onDelete: Restrict)
  travellers         VisaCaseTraveller[]
  consent            Consent?
  consentLinks       ConsentLink[]
  documents          ClientDocument[]

  @@index([clientId])
  @@index([passportNumber])
  /// The New enquiry lookup (equality) and the Clients search (any part).
  @@index([mobile])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "ClientMember_name_trgm_idx")
  @@index([mobile(ops: raw("gin_trgm_ops"))], type: Gin, map: "ClientMember_mobile_trgm_idx")
}

/// Free text with author and date (demo). Never read by reports or rules (§7 rule 2). Append-only.
model ClientNote {
  id        String   @id @default(uuid())
  clientId  String
  body      String
  authorId  String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  author    User     @relation("ClientNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([clientId, createdAt])
}

/// The client document vault (docs/decisions/0016-client-documents.md): a scan of one of the client's papers, kept in
/// the private bucket (CLAUDE.md rule 4) and reused on later cases. Never changed or deleted (nothing is removed until
/// M40 is answered): the newest scan of a paper for a person is the current one; older ones stay and still open.
model ClientDocument {
  id            String             @id @default(uuid())
  clientId      String
  /// Whose paper it is (a passport, an Aadhaar card); null for the client's own (a company's PAN card). The service
  /// keeps it to a member of the same client.
  memberId      String?
  /// Which paper, from the document master.
  documentId    Int
  /// clients/<clientId>/<uuid>.pdf|jpg|png: no two uploads ever share a key.
  storageKey    String             @unique
  /// The name it opens and saves under: Aarav-Mehta_Passport_2026-10-17.pdf.
  fileName      String
  /// application/pdf, image/jpeg or image/png (checked in the migration), as the file's first bytes show.
  contentType   String
  sizeBytes     Int
  /// A PDF's pages; null for a photo (checked in the migration).
  pageCount     Int?
  uploadedById  String
  uploadedAt    DateTime           @default(now()) @db.Timestamptz(3)
  client        Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  member        ClientMember?      @relation(fields: [memberId], references: [id], onDelete: Restrict)
  document      DocumentMaster     @relation(fields: [documentId], references: [id], onDelete: Restrict)
  uploadedBy    User               @relation("ClientDocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  /// Case papers ticked On file from this scan.
  caseDocuments VisaCaseDocument[]

  @@index([clientId, uploadedAt])
  @@index([memberId, documentId, uploadedAt])
  @@index([documentId])
  @@index([uploadedById])
}

// ---------------------------------------------------------------------------
// System masters: countries, visa types, embassies (admin-edited in Settings → Masters).
// See docs/decisions/0005-system-masters.md.
// ---------------------------------------------------------------------------

model Country {
  id              Int                     @id @default(autoincrement())
  /// ISO 3166-1 alpha-2, e.g. "FR". Also how the bot names a country. Never changes.
  code            String                  @unique
  name            String /// "France"
  /// Shown in brackets: "France (Schengen)".
  zone            String?
  sortOrder       Int                     @default(0)
  isActive        Boolean                 @default(true)
  offerings       VisaOffering[]
  embassies       Embassy[]
  holidayTargets  HolidayTarget[]
  vendors         VendorCountry[]
  coveringLetters CoveringLetterCountry[]
}

model VisaType {
  id              Int                    @id @default(autoincrement())
  /// TOURIST, BUSINESS, STUDENT… Never changes.
  code            String                 @unique
  name            String
  sortOrder       Int                    @default(0)
  isActive        Boolean                @default(true)
  offerings       VisaOffering[]
  coveringLetters CoveringLetterFormat[]
}

/// A post where files are submitted: an embassy, consulate or visa centre.
model Embassy {
  id             Int             @id @default(autoincrement())
  /// Stable key, e.g. "FR-MUM". The bot uses it to target one post. Never changes.
  code           String          @unique
  countryId      Int
  name           String /// "French embassy, Mumbai"
  city           String /// "Mumbai"
  sortOrder      Int             @default(0)
  isActive       Boolean         @default(true)
  country        Country         @relation(fields: [countryId], references: [id], onDelete: Restrict)
  holidayTargets HolidayTarget[]
  /// Visa files submitted here (docs/decisions/0011-visa-at-vendor.md Decision 3).
  visaCases      VisaCase[]

  @@index([countryId])
}

// ---------------------------------------------------------------------------
// Vendors (docs/decisions/0007-visa-file-prep.md Decision 7). Only the Visa HOD or the Head adds one, and adding
// approves it. Switched off, never deleted: a case that picked a vendor keeps it.
// ---------------------------------------------------------------------------

/// Visa submission agents now; hotel vendors join with Hotels (Stage 2).
enum VendorKind {
  VISA_AGENT
}

/// Unique (kind, lower(name), lower(city)), and name and city not blank: hand-written in the migration.
model Vendor {
  id          Int             @id @default(autoincrement())
  kind        VendorKind      @default(VISA_AGENT)
  name        String /// "Global Visa Services"
  city        String /// "Mumbai"
  contactName String?
  /// +91XXXXXXXXXX (src/lib/contact.ts).
  mobile      String?
  /// Lowercased. Required: Step 4's dispatch email goes to it (0008 Decision 8).
  email       String
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)
  countries   VendorCountry[]
  /// The visa cases that picked it (0007 Decision 7). A vendor is never deleted, so they keep it.
  cases       VisaCase[]
  dockets     Docket[]
}

/// The countries a vendor submits files for ("Mumbai · Schengen"). Replaced as a set when the vendor is edited.
model VendorCountry {
  vendorId  Int
  countryId Int
  vendor    Vendor  @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  country   Country @relation(fields: [countryId], references: [id], onDelete: Restrict)

  @@id([vendorId, countryId])
  @@index([countryId])
}

// ---------------------------------------------------------------------------
// Covering letters (docs/decisions/0019-covering-letters.md): the fixed letter to the embassy for a visa and who
// travels, filled in from the case and printed on the client's letterhead. Only the wording is effective-dated: a new
// one applies from its "use from" day. Formats are switched off, never deleted.
// ---------------------------------------------------------------------------

/// Who travels on the cases a format is for (0019 Decision 3): the case offers only the formats that fit. Family,
/// friends or a parent with a child are separate formats, told apart by name.
enum CoveringLetterParty {
  /// One traveller.
  ONE
  /// Two or more.
  SEVERAL
}

/// A fixed format: "Schengen · tourist · family". Its wording is in CoveringLetterVersion (always at least one, kept by
/// the service). Unique lower(name), and the name not blank: hand-written in the migration.
model CoveringLetterFormat {
  id         Int                     @id @default(autoincrement())
  /// What staff pick it by. Never printed.
  name       String
  /// The process. With the countries and the party, it decides which cases the format fits.
  visaTypeId Int
  party      CoveringLetterParty
  sortOrder  Int                     @default(0)
  isActive   Boolean                 @default(true)
  createdAt  DateTime                @default(now()) @db.Timestamptz(3)
  /// Moved by every change, a wording added or removed too: the optimistic-lock token every write sends back.
  updatedAt  DateTime                @updatedAt @db.Timestamptz(3)
  visaType   VisaType                @relation(fields: [visaTypeId], references: [id], onDelete: Restrict)
  countries  CoveringLetterCountry[]
  versions   CoveringLetterVersion[]

  @@index([visaTypeId])
}

/// The countries a format is for ("Schengen" = France, Germany…). Replaced as a set when the format is edited.
model CoveringLetterCountry {
  formatId  Int
  countryId Int
  format    CoveringLetterFormat @relation(fields: [formatId], references: [id], onDelete: Restrict)
  country   Country              @relation(fields: [countryId], references: [id], onDelete: Restrict)

  @@id([formatId, countryId])
  @@index([countryId])
}

/// One wording of a format, used from effectiveFrom (a day in India) until a later one starts; on the same day, the one
/// added last (the higher id). Never edited, and removed only before its day (a trigger in the migration). The body is
/// not blank and at most 6,000 characters (checked in the migration).
model CoveringLetterVersion {
  id            Int                  @id @default(autoincrement())
  formatId      Int
  /// "Use from": the first day letters use this wording.
  effectiveFrom DateTime             @db.Date
  /// Plain text with {blanks}; a blank line starts a new paragraph, a single line break stays.
  body          String
  /// Who added it. Null for the sample wordings the seed sets up (it runs before any user exists).
  addedById     String?
  createdAt     DateTime             @default(now()) @db.Timestamptz(3)
  format        CoveringLetterFormat @relation(fields: [formatId], references: [id], onDelete: Restrict)
  addedBy       User?                @relation("CoveringLetterVersionAddedBy", fields: [addedById], references: [id], onDelete: Restrict)
  /// The cases whose letter was made with it (0019 Decision 10).
  cases         VisaCase[]

  @@index([formatId, effectiveFrom])
  @@index([addedById])
}

// ---------------------------------------------------------------------------
// Dockets (docs/decisions/0008-visa-docket-dispatch.md): the parcel of visa files going to one vendor.
// ---------------------------------------------------------------------------

/// Code branches on it. DISPATCHED gets its columns (courier, AWB, who and when) with the Dispatch card.
enum DocketStatus {
  OPEN
  DISPATCHED
}

/// "Several files in one" (GROUP: the vendor's shared docket) or "One file per docket" (OWN: one case, nobody joins).
enum DocketKind {
  GROUP
  OWN
}

/// Hand-written in the migration: at most one OPEN GROUP docket per vendor (a partial unique index), and the
/// number's format. An emptied open docket stays and is reused by the vendor's next case of the same kind.
model Docket {
  id                   String       @id @default(uuid())
  /// "D-2026-0001": the prefix is the setting visa.docket, the counter runs per calendar year (IST).
  docketNo             String       @unique
  vendorId             Int
  kind                 DocketKind
  status               DocketStatus @default(OPEN)
  /// When it started holding cases: "Open since 12 Oct, not sent yet". Reset when a case joins an empty docket.
  openedAt             DateTime     @default(now()) @db.Timestamptz(3)
  createdById          String
  createdAt            DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @db.Timestamptz(3)
  /// Dispatch (0008 Decision 9): all set together when the docket is DISPATCHED, none while it is OPEN (a CHECK).
  courierId            Int?
  /// The courier's slip number, typed in: capitals and digits (the setting visa.awb). Null for "By hand".
  awbNo                String?
  dispatchedAt         DateTime?    @db.Timestamptz(3)
  dispatchedById       String?
  /// The email to the vendor (0008 Decision 8), sent after dispatch: when and to whom, or why it failed ("Send again").
  vendorEmailSentAt    DateTime?    @db.Timestamptz(3)
  vendorEmailTo        String?
  vendorEmailError     String?
  /// When a send started that hasn't recorded its outcome yet: marked before the mail server is called, so no lock is
  /// held during the send and a second press waits. Cleared with the outcome; a stuck one (the server stopped
  /// mid-send) may be retried after a few minutes.
  vendorEmailSendingAt DateTime?    @db.Timestamptz(3)
  vendor               Vendor       @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  createdBy            User         @relation("DocketCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  courier              Courier?     @relation(fields: [courierId], references: [id], onDelete: Restrict)
  dispatchedBy         User?        @relation("DocketDispatchedBy", fields: [dispatchedById], references: [id], onDelete: Restrict)
  cases                VisaCase[]

  @@index([vendorId, status])
  @@index([createdById])
  @@index([courierId])
  @@index([dispatchedById])
}

/// The last docket number used per calendar year (IST), bumped in the docket's own transaction like CaseCounter.
model DocketCounter {
  year      Int @id
  lastValue Int @default(0)
}

// ---------------------------------------------------------------------------
// Holiday calendar
// ---------------------------------------------------------------------------

enum HolidayStatus {
  /// Blocks dates.
  ACTIVE
  /// Taken off the calendar. Kept for the record.
  REMOVED
}

enum HolidayRepeat {
  /// startDate…endDate inclusive (equal for one day).
  NONE
  /// Every `weekday`, from startDate until endDate (or for good).
  WEEKLY
}

enum HolidayTargetKind {
  ALL_EMBASSIES
  /// Every post of countryId.
  COUNTRY
  /// One post: embassyId.
  EMBASSY
  /// Masti's office, collections and deliveries.
  MASTI_OFFICE
}

/// Checks in the migration:
/// - repeat = NONE   ⇒ endDate set, endDate >= startDate, weekday null
/// - repeat = WEEKLY ⇒ weekday 1–7, endDate null or >= startDate
/// Staff-entered only (the AI-bot path was removed on 9 Oct 2026; see 0005's amendment).
model Holiday {
  id        String          @id @default(uuid())
  /// "Dussehra", "National Day week". A label, not a reported value.
  name      String
  repeat    HolidayRepeat   @default(NONE)
  startDate DateTime        @db.Date
  endDate   DateTime?       @db.Date
  /// ISO weekday, 1 = Monday … 7 = Sunday. WEEKLY only.
  weekday   Int?            @db.SmallInt
  status    HolidayStatus   @default(ACTIVE)
  /// Where it was announced: "IVS", or the embassy notice URL. Display only.
  reference String?
  /// The staff member who added it. Null for seeded rows (the seed runs before any user exists).
  addedById String?
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  /// Also the optimistic-lock token for PATCH.
  updatedAt DateTime        @updatedAt @db.Timestamptz(3)
  addedBy   User?           @relation("HolidayAddedBy", fields: [addedById], references: [id], onDelete: Restrict)
  targets   HolidayTarget[]

  @@index([status, startDate])
}

/// What a holiday applies to. At least one per holiday (checked in the service).
/// Checks in the migration: COUNTRY ⇒ countryId only; EMBASSY ⇒ embassyId only; otherwise neither.
/// Unique (holidayId, kind, countryId, embassyId) NULLS NOT DISTINCT, in the migration.
model HolidayTarget {
  id        Int               @id @default(autoincrement())
  holidayId String
  kind      HolidayTargetKind
  countryId Int?
  embassyId Int?
  holiday   Holiday           @relation(fields: [holidayId], references: [id], onDelete: Cascade)
  country   Country?          @relation(fields: [countryId], references: [id], onDelete: Restrict)
  embassy   Embassy?          @relation(fields: [embassyId], references: [id], onDelete: Restrict)

  @@index([holidayId])
  @@index([kind, countryId])
  @@index([kind, embassyId])
}

// ---------------------------------------------------------------------------
// Notice board (docs/decisions/0017-today-dashboard.md Decision 11)
// ---------------------------------------------------------------------------

/// What a notice is about: the board's filter pills (Airline / Embassy / Hotel), and General for the rest (a process, office
/// news). The filters branch on it, so an enum.
enum NoticeCategory {
  AIRLINE
  EMBASSY
  HOTEL
  GENERAL
}

/// Where a notice came from: someone in the team, or copied from the IVS visa-news feed (demo: "Vimal · from IVS").
enum NoticeSource {
  TEAM
  IVS
}

enum NoticeStatus {
  /// On the board.
  ACTIVE
  /// Taken off the board. Kept for the record.
  REMOVED
}

/// A post on the notice board: what a department needs to know (demo screen 27). Its department's staff post it; its
/// author, the department's HOD and the Head change or remove it.
/// Checks in the migration: title not blank; about and body null or not blank.
model Notice {
  id             String         @id @default(uuid())
  departmentId   Int
  category       NoticeCategory
  /// Which airline, embassy or hotel ("China", "IndiGo", "Marriott Dubai"); for a general one a word such as "Process".
  about          String?
  title          String
  /// The details. Optional: a title can say it all.
  body           String?
  source         NoticeSource   @default(TEAM)
  status         NoticeStatus   @default(ACTIVE)
  /// When the Head or the Visa HOD put it in the visa team's login popup (Decision 12); null: not in it. Visa notices only.
  loginPopupAt   DateTime?      @db.Timestamptz(3)
  /// Who put it there: it isn't news to them (set exactly with loginPopupAt: a CHECK in the migration).
  loginPopupById String?
  postedById     String
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  /// Also the optimistic-lock token for PATCH.
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)
  department     Department     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  postedBy       User           @relation("NoticePostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  loginPopupBy   User?          @relation("NoticePickedBy", fields: [loginPopupById], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([departmentId, status, createdAt])
}

// ---------------------------------------------------------------------------
// Visa document master
// ---------------------------------------------------------------------------

/// A visa Masti processes: country × visa type. The checklist (and, later, fees) hang off it.
model VisaOffering {
  id                Int                 @id @default(autoincrement())
  countryId         Int
  visaTypeId        Int
  isActive          Boolean             @default(true)
  /// "File ready" asks every traveller for a portal appointment (0007 Decision 6). Off for e-visas. Read live.
  appointmentNeeded Boolean             @default(true)
  /// "File ready" asks for a vendor (0007 Decision 6). Off for e-visas. Read live.
  vendorNeeded      Boolean             @default(true)
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  /// Bumped when the checklist is replaced: the optimistic-lock token for PUT …/checklist.
  updatedAt         DateTime            @updatedAt @db.Timestamptz(3)
  country           Country             @relation(fields: [countryId], references: [id], onDelete: Restrict)
  visaType          VisaType            @relation(fields: [visaTypeId], references: [id], onDelete: Restrict)
  /// The government portal staff open from this visa's cases with "Log in for me" (0024 component 3): one of the Visa
  /// department's portals, picked on the visa's settings page. Null: none saved. Cleared when that portal is removed.
  portalLoginId     String?
  checklist         VisaChecklistItem[]
  cases             VisaCase[]
  portalLogin       PortalLogin?        @relation(fields: [portalLoginId], references: [id], onDelete: Restrict)

  @@unique([countryId, visaTypeId])
  @@index([portalLoginId])
}

/// Every document a checklist can ask for. No department: insurance claim checklists reuse it later, and the client
/// document vault (0016) files its scans under it.
model DocumentMaster {
  id              Int                 @id @default(autoincrement())
  /// PASSPORT, OLD_PASSPORTS, BANK_STATEMENT_6M… Never changes.
  code            String              @unique
  /// "Bank statement, last 6 months"
  name            String
  /// Shown to the client with the name, e.g. "35×45 mm, white background".
  detail          String?
  sortOrder       Int                 @default(0)
  isActive        Boolean             @default(true)
  /// "Scan not saved" on a case when this paper is ticked Original or Xerox and no scan was kept during the case
  /// (docs/decisions/0016-client-documents.md Decision 7). A warning only.
  warnIfNoScan    Boolean             @default(false)
  /// Upload rules (0016 Amendment 1, change request 16), checked when a scan of this paper is uploaded. Which file
  /// types may be uploaded: at least one (database check).
  fileTypes       ScanFileType[]      @default([PDF, JPG, PNG])
  /// The smallest and largest file, 0.01–50 MB, min below max (database checks). Null: no minimum, and the shared
  /// clients.documents.maxMb.
  minSizeMb       Float?
  maxSizeMb       Float?
  /// The photo's size in mm (35 × 45). Only its shape is checked, on a JPG or PNG, so any size above 0 will do. Both or
  /// neither (database check).
  photoWidthMm    Int?                @db.SmallInt
  photoHeightMm   Int?                @db.SmallInt
  /// The smallest and largest photo in pixels, as visa websites ask (600 × 600 to 1200 × 1200; the same pair for an
  /// exact size), checked on a JPG or PNG. Each pair both or neither, above 0, the smallest not bigger than the largest
  /// (database check). Null: no limit.
  minWidthPx      Int?                @db.SmallInt
  minHeightPx     Int?                @db.SmallInt
  maxWidthPx      Int?                @db.SmallInt
  maxHeightPx     Int?                @db.SmallInt
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(3)
  checklistItems  VisaChecklistItem[]
  caseDocuments   VisaCaseDocument[]
  clientDocuments ClientDocument[]
}

/// A file type a paper's scan may be. Fixed (change request 16): the vault keeps PDF, JPEG and PNG only.
enum ScanFileType {
  PDF
  JPG
  PNG
}

/// What we need. Code branches on it (Original/Xerox toggle, "Made" for things we arrange), so an enum.
enum DocumentRequirement {
  ORIGINAL
  XEROX_OK
  ARRANGED_BY_US
}

/// Which travellers a checklist line (or, later, a fee) applies to.
enum TravellerGroup {
  ALL
  ADULTS
  CHILDREN
}

/// One line of a country × visa type checklist. Copied onto each traveller at intake,
/// so replacing lines never changes an open case.
model VisaChecklistItem {
  id          Int                 @id @default(autoincrement())
  offeringId  Int
  documentId  Int
  requirement DocumentRequirement
  appliesTo   TravellerGroup      @default(ALL)
  /// "Photos 35×45 mm (2)". 1–20 (database check).
  quantity    Int                 @default(1) @db.SmallInt
  /// A per-visa instruction for the client ("signed by both parents"). Display only.
  note        String?
  sortOrder   Int                 @default(0)
  offering    VisaOffering        @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  document    DocumentMaster      @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@unique([offeringId, documentId])
  @@index([documentId])
}

// ---------------------------------------------------------------------------
// Enquiries (shared by every department). See docs/decisions/0003-visa-intake.md.
// ---------------------------------------------------------------------------

/// A department's steps, in order, per flow. The labels are demo wording ⚠️, so they live here, not in code.
/// A department can run more than one flow: Insurance has policies (4 steps) and claims (7 steps, §10.2).
/// An enquiry's flow is its stage's flow; "step 2 of 7" counts that flow only.
model DepartmentStage {
  id            Int        @id @default(autoincrement())
  departmentId  Int
  /// Stable key the code uses: "VISA"; later e.g. "INSURANCE_POLICY", "INSURANCE_CLAIM". Never changes.
  flow          String
  /// Stable key the code uses: "ENQUIRY", "DOCUMENTS"… Unique within the flow. Never changes.
  code          String
  /// "Enquiry"
  name          String
  /// 1, 2, 3…: the step number shown as "1/8".
  sortOrder     Int
  /// The status chip while a case is at this step: "Documents pending".
  statusLabel   String
  /// The next-step button: "Start collecting documents".
  nextStepLabel String
  department    Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  enquiries     Enquiry[]

  @@unique([departmentId, flow, code])
  @@unique([departmentId, flow, sortOrder])
}

/// The last case number issued, per department per calendar year (IST). Bumped in the enquiry's own transaction,
/// so two saves never share a number and a failed save doesn't use one up.
model CaseCounter {
  departmentId Int
  year         Int
  lastValue    Int        @default(0)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@id([departmentId, year])
}

/// Code branches on it (lists, Today, reports), so an enum. The *reasons* are master data (EnquiryReason).
enum EnquiryStatus {
  OPEN
  POSTPONED
  CANCELLED
  LOST
  CLOSED
}

/// What created the row. Not the same as the source (how the client reached us).
enum EnquiryOrigin {
  STAFF
  WHATSAPP_BOT
  WEBSITE_FORM
  CROSS_SELL
  IMPORT
}

/// "Came in through". Master data, edited in Settings → Masters.
model EnquirySource {
  id              Int       @id @default(autoincrement())
  /// WHATSAPP, LANDLINE, MOBILE, SOCIAL_MEDIA, EMAIL, WEBSITE_FORM… Never changes.
  code            String    @unique
  name            String
  sortOrder       Int       @default(0)
  isActive        Boolean   @default(true)
  /// False for sources only integrations set (Website form, WhatsApp bot); hidden on the staff form.
  staffSelectable Boolean   @default(true)
  enquiries       Enquiry[]
}

// Follow-up and reason dropdowns (0006 Decision 7). Each value is tagged with the departments it shows in (0018); the
// Head, or the HOD of every one of those departments, edits it. The seeded values are demo samples ⚠️. Switched off,
// never deleted. Codes never change (format checked in the migration).

/// "What happened" on a follow-up. Only a label: no outcome triggers anything (staff postpone or cancel themselves).
model FollowUpOutcome {
  id          Int                         @id @default(autoincrement())
  code        String                      @unique
  name        String
  sortOrder   Int                         @default(0)
  isActive    Boolean                     @default(true)
  followUps   FollowUp[]
  /// At least one, checked by the service. Replaced as a set when the value is edited.
  departments FollowUpOutcomeDepartment[]
}

model FollowUpOutcomeDepartment {
  outcomeId    Int
  departmentId Int
  outcome      FollowUpOutcome @relation(fields: [outcomeId], references: [id], onDelete: Restrict)
  department   Department      @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@id([outcomeId, departmentId])
  @@index([departmentId])
}

/// "Next step" on a follow-up.
model FollowUpNextStep {
  id          Int                          @id @default(autoincrement())
  code        String                       @unique
  name        String
  sortOrder   Int                          @default(0)
  isActive    Boolean                      @default(true)
  followUps   FollowUp[]
  /// At least one, checked by the service. Replaced as a set when the value is edited.
  departments FollowUpNextStepDepartment[]
}

model FollowUpNextStepDepartment {
  nextStepId   Int
  departmentId Int
  nextStep     FollowUpNextStep @relation(fields: [nextStepId], references: [id], onDelete: Restrict)
  department   Department       @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@id([nextStepId, departmentId])
  @@index([departmentId])
}

/// Which action a reason belongs to. LOST comes when closing and losing are built.
enum EnquiryReasonKind {
  POSTPONE
  CANCEL
}

/// Why an enquiry was postponed or cancelled. No free text (§7 rule 2).
model EnquiryReason {
  id          Int                       @id @default(autoincrement())
  kind        EnquiryReasonKind
  code        String                    @unique
  name        String
  sortOrder   Int                       @default(0)
  isActive    Boolean                   @default(true)
  enquiries   Enquiry[]
  /// At least one, checked by the service. Replaced as a set when the reason is edited.
  departments EnquiryReasonDepartment[]

  @@index([kind, isActive])
}

model EnquiryReasonDepartment {
  reasonId     Int
  departmentId Int
  reason       EnquiryReason @relation(fields: [reasonId], references: [id], onDelete: Restrict)
  department   Department    @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@id([reasonId, departmentId])
  @@index([departmentId])
}

model Enquiry {
  id              String            @id @default(uuid())
  /// VISA-2026-0001. Never changes once issued.
  caseNo          String            @unique
  departmentId    Int
  clientId        String
  sourceId        Int
  origin          EnquiryOrigin     @default(STAFF)
  /// A repeat request with the same key returns this enquiry instead of creating another.
  idempotencyKey  String?           @unique
  stageId         Int
  status          EnquiryStatus     @default(OPEN)
  /// "Whose job it is now". Null = not assigned yet (e.g. a future bot enquiry).
  ownerId         String?
  /// When someone must next act on it: the list order, Today, the follow-up desk and "running late".
  dueAt           DateTime?         @db.Timestamptz(3)
  /// Why it was postponed or cancelled. Checked in the migration: POSTPONED and CANCELLED need one.
  reasonId        Int?
  /// When a postponed enquiry comes back (POSTPONED needs one). dueAt is set to that day.
  resumeOn        DateTime?         @db.Date
  /// Null when an integration created it.
  createdById     String?
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  /// Optimistic-lock token for the case actions (follow-up, postpone, reassign, mature…).
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)
  department      Department        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  client          Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  source          EnquirySource     @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  stage           DepartmentStage   @relation(fields: [stageId], references: [id], onDelete: Restrict)
  owner           User?             @relation("EnquiryOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdBy       User?             @relation("EnquiryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reason          EnquiryReason?    @relation(fields: [reasonId], references: [id], onDelete: Restrict)
  visa            VisaCase?
  followUps       FollowUp[]
  files           CaseFile[]
  invoices        Invoice[]
  /// The collection and delivery boy's jobs for it (0015).
  fieldJobs       FieldJob[]
  creditNotes     CreditNote[]
  /// The client's messages about it (docs/decisions/0021-whatsapp-outbox.md).
  messages        OutboundMessage[]
  /// The AI calls made for it (docs/decisions/0023-ai.md).
  aiCalls         AiCall[]
  /// Consent links sent from it (docs/decisions/0022-consent-form.md).
  consentLinks    ConsentLink[]
  /// "Log in for me" pressed on this case (docs/decisions/0024-portal-logins.md component 3).
  portalLoginUses PortalLoginUse[]
  /// Given to its owner by the HOD or the Head, and not seen yet (0006 amendment 22).
  unseenBy        UnseenAssignment?

  @@index([status, dueAt])
  @@index([departmentId, status, dueAt])
  @@index([ownerId, status, dueAt])
  @@index([clientId])
}

enum CaseFileKind {
  /// The visa file as it went to the vendor, one PDF (docs/decisions/0007-visa-file-prep.md Decision 8).
  FINAL_FILE
  /// The case's tax invoice, as raised (docs/decisions/0009-visa-invoice.md Decision 7). Never regenerated.
  INVOICE
  /// A credit note against one of its invoices, as issued (docs/decisions/0011-visa-at-vendor.md Decision 5).
  CREDIT_NOTE
  /// A refused traveller's refusal letter, scanned (docs/decisions/0012-visa-decision.md Decision 4). Has a traveller.
  REFUSAL_LETTER
  /// A photo of the person the passports were handed to (docs/decisions/0014-visa-delivered.md Decision 3): a JPEG or
  /// PNG, so it has no page count.
  RECEIVER_PHOTO
  /// The field boy's selfie at the client's door (docs/decisions/0015-field-staff-app.md Decision 4): a photo, no page
  /// count. Linked to the job once he finishes it.
  FIELD_SELFIE
  /// An approved e-visa traveller's e-visa, as the portal issued it (docs/decisions/0025-evisa-after-decision.md). Has a
  /// traveller.
  EVISA
}

/// A file kept for a case in the private S3-compatible bucket (CLAUDE.md rule 4). Never deleted: a newer upload of the
/// same kind becomes the current one, and the older ones stay as proof.
model CaseFile {
  id           String             @id @default(uuid())
  enquiryId    String
  kind         CaseFileKind
  /// cases/<enquiryId>/final/<uuid>.pdf: no two uploads ever share a key.
  storageKey   String             @unique
  /// The name it opens and saves under: VISA-2026-0001_Mehta_file.pdf.
  fileName     String
  sizeBytes    Int
  /// A PDF's pages; a photo has none (checked in the migration).
  pageCount    Int?
  uploadedById String
  uploadedAt   DateTime           @default(now()) @db.Timestamptz(3)
  /// The traveller a refusal letter (0012 Decision 4) or an e-visa (0025) is for: set for REFUSAL_LETTER and EVISA and
  /// only for them (checked in the migration). The service keeps it to a traveller of the same case.
  travellerId  String?
  enquiry      Enquiry            @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  uploadedBy   User               @relation("CaseFileUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  traveller    VisaCaseTraveller? @relation(fields: [travellerId], references: [id], onDelete: Restrict)
  invoice      Invoice?
  creditNote   CreditNote?
  /// The handover this photo proves (0014): set once "Hand over" links it.
  handover     VisaHandover?
  /// The field job this selfie proves (0015): set once he finishes it.
  fieldJob     FieldJob?          @relation("FieldJobSelfie")
  /// WhatsApp messages that carried this file to the client (0025, part 2).
  messages     OutboundMessage[]

  @@index([enquiryId, kind, uploadedAt])
  @@index([travellerId, uploadedAt])
}

/// A logged follow-up: What happened → Next step → When (0006 Decision 6). Append-only. Logging one sets the
/// enquiry's dueAt to nextAt.
model FollowUp {
  id         String           @id @default(uuid())
  enquiryId  String
  outcomeId  Int
  nextStepId Int
  /// "When": the next contact, also the enquiry's new dueAt.
  nextAt     DateTime         @db.Timestamptz(3)
  byId       String
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)
  enquiry    Enquiry          @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  outcome    FollowUpOutcome  @relation(fields: [outcomeId], references: [id], onDelete: Restrict)
  nextStep   FollowUpNextStep @relation(fields: [nextStepId], references: [id], onDelete: Restrict)
  by         User             @relation("FollowUpBy", fields: [byId], references: [id], onDelete: Restrict)

  @@index([enquiryId, createdAt])
}

/// A case the HOD or the Head gave to someone, who hasn't clicked its department in the sidebar since: the red dot there
/// (docs/decisions/0006-visa-documents.md amendment 22). One row per case, for the person it was given to; giving it to
/// someone else replaces it. Clicking the department deletes that person's rows of it.
model UnseenAssignment {
  enquiryId String   @id
  userId    String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  enquiry   Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  user      User     @relation("UnseenAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Visa cases: the visa part of an Enquiry (same id)
// ---------------------------------------------------------------------------

/// Code branches on it later (the field app makes a pickup job for COLLECTION_BOY), so an enum.
enum DocumentArrival {
  CLIENT_BRINGS
  COLLECTION_BOY
}

/// The visa's entries (0007 Decision 4). The visa rules fix these, and the forms will branch on them.
enum EntryType {
  SINGLE
  DOUBLE
  MULTIPLE
}

/// Traveller counts come from the VisaCaseTraveller rows.
/// Checks in the migration: travelMonth is the 1st of a month; travelDate, if set, falls in that month;
/// booklet counts are 0–50; returnOn is not before departOn; hotelStay is 1–200 characters.
model VisaCase {
  enquiryId               String                 @id
  offeringId              Int
  /// The month they plan to travel, stored as the 1st (M9).
  travelMonth             DateTime               @db.Date
  /// The exact date, if the client knows it at intake.
  travelDate              DateTime?              @db.Date
  /// Step 2: "Client brings them" or "Send collection boy".
  arrival                 DocumentArrival?
  /// Step 2: passports received (current + old). Checked again at handover.
  bookletsCurrent         Int?                   @db.SmallInt
  bookletsOld             Int?                   @db.SmallInt
  /// Step 2's Reminders switch (0006 amendment 19): off stops this case's pending-document reminders. When the next one
  /// goes out is worked out from the intake day and the setting visa.documentReminders, not stored.
  remindersOn             Boolean                @default(true)
  /// Trip details (0007 Decision 4), entered in Documents or File preparation. departOn starts as the intake's
  /// travelDate. "File ready" needs departOn, returnOn and entryType.
  departOn                DateTime?              @db.Date
  returnOn                DateTime?              @db.Date
  entryType               EntryType?
  /// The hotel's name and city, for the forms: data, not a reason or a status.
  hotelStay               String?
  /// The submission agent, picked during File preparation from the active vendors covering the case's country
  /// (0007 Decision 7). Switched off later, it stays here; "File ready" then asks for an active one.
  vendorId                Int?
  /// "Mark documents complete" (0006 Decision 8). Whoever matured it can't be its processor.
  maturedAt               DateTime?              @db.Timestamptz(3)
  maturedById             String?
  /// "File ready — add to docket" (0007 Decision 9): Step 3 is done and the case moved to Docket & dispatch. Both set
  /// together (checked in the migration).
  fileReadyAt             DateTime?              @db.Timestamptz(3)
  fileReadyById           String?
  /// The docket it goes to the vendor in (0008 Decision 2). Set by "Add to docket", cleared by "Take out" while the
  /// docket is open.
  docketId                String?
  /// "Submitted online" (0008 Decision 11): an e-visa (Vendor needed off) went in on the portal, with no docket, and the
  /// case moved to At vendor. Both set together, and never with a docket (checked in the migration).
  submittedOnlineAt       DateTime?              @db.Timestamptz(3)
  submittedOnlineById     String?
  /// "Vendor got it, papers checked" (0011 Decision 2): the vendor has this file, at Step 5. Both set together, and only
  /// for a file sent in a docket (checked in the migration).
  vendorReceivedAt        DateTime?              @db.Timestamptz(3)
  vendorReceivedById      String?
  /// "Submitted at the embassy" (0011 Decisions 3 and 4): the vendor's file number, the embassy it went to and the
  /// expected collection date, all saved together, with who first saved them and when. All set or none, only after the
  /// vendor got the file, and the file number's format (checked in the migration).
  vendorFileNo            String?
  embassyId               Int?
  collectionOn            DateTime?              @db.Date
  submittedAt             DateTime?              @db.Timestamptz(3)
  submittedById           String?
  /// "Take the file back" (0011 Decision 6): recalled from the vendor, why and by whom; the case then goes to Passport
  /// back. All three set together, and only for a file sent in a docket (checked in the migration).
  recalledAt              DateTime?              @db.Timestamptz(3)
  recalledById            String?
  recallReasonId          Int?
  /// "Record the decision" (docs/decisions/0012-visa-decision.md Decision 6): every traveller's outcome was saved and
  /// the case moved to Decision, by whom and when. Set together, only after the embassy submission or "Submitted
  /// online", and never on a recalled file (checked in the migration).
  decidedAt               DateTime?              @db.Timestamptz(3)
  decidedById             String?
  /// "Passports on the way back" (docs/decisions/0013-visa-passport-back.md Decision 3): the day the vendor collected
  /// the passports, the day they're expected at our office, and who recorded it when. They're in transit from then
  /// until they're marked received. All four set together, only after the decision or a recall, never for an e-visa,
  /// expected on or after collected, and collected no later than the day it was recorded (checked in the migration).
  passportsCollectedOn    DateTime?              @db.Date
  passportsExpectedOn     DateTime?              @db.Date
  passportsInTransitAt    DateTime?              @db.Timestamptz(3)
  passportsInTransitById  String?
  /// "Mark received" (docs/decisions/0013-visa-passport-back.md Decision 5): the packet was opened at our office and
  /// the passports are in our stock, by whom and when, with the booklets counted (current and old). All four set
  /// together, only after they were on their way back, each count 0–50 and at least one booklet (checked in the
  /// migration). Never changed once saved (decided 17 Oct 2026), except that "Received the rest" adds the late booklets
  /// of a short return, up to what went out (0013 Decision 5, amended 17 Oct 2026).
  passportsReceivedAt     DateTime?              @db.Timestamptz(3)
  passportsReceivedById   String?
  bookletsBackCurrent     Int?                   @db.SmallInt
  bookletsBackOld         Int?                   @db.SmallInt
  /// "Send the e-visa" (docs/decisions/0025-evisa-after-decision.md, part 3): each approved traveller's e-visa went to
  /// the client on WhatsApp, by whom and when. Both set together, and only on an e-visa (checked in the migration).
  evisaSentAt             DateTime?              @db.Timestamptz(3)
  evisaSentById           String?
  /// A short return cleared rather than found (0013 Decision 5, amended 17 Oct 2026): when, by whom and why, from the
  /// missing-passport-reasons list. All three set together, only once received (checked in the migration).
  shortfallClearedAt      DateTime?              @db.Timestamptz(3)
  shortfallClearedById    String?
  shortfallReasonId       Int?
  /// "Make the letter" (docs/decisions/0019-covering-letters.md Decision 10, amendments 1 and 3): the covering-letter
  /// wording its text started from, who made it and when, and the letter's text as staff left it (its tables are lines
  /// with | between the columns), so a reprint is the same letter. Made at File preparation, again as often as needed;
  /// all four set together, and the text not blank and at most 60,000 characters (checked in the migrations).
  coveringLetterVersionId Int?
  coveringLetterMadeAt    DateTime?              @db.Timestamptz(3)
  coveringLetterMadeById  String?
  coveringLetterText      String?
  enquiry                 Enquiry                @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  offering                VisaOffering           @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  maturedBy               User?                  @relation("VisaCaseMaturedBy", fields: [maturedById], references: [id], onDelete: Restrict)
  fileReadyBy             User?                  @relation("VisaCaseFileReadyBy", fields: [fileReadyById], references: [id], onDelete: Restrict)
  submittedOnlineBy       User?                  @relation("VisaCaseSubmittedOnlineBy", fields: [submittedOnlineById], references: [id], onDelete: Restrict)
  vendorReceivedBy        User?                  @relation("VisaCaseVendorReceivedBy", fields: [vendorReceivedById], references: [id], onDelete: Restrict)
  submittedBy             User?                  @relation("VisaCaseSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  recalledBy              User?                  @relation("VisaCaseRecalledBy", fields: [recalledById], references: [id], onDelete: Restrict)
  decidedBy               User?                  @relation("VisaCaseDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)
  passportsInTransitBy    User?                  @relation("VisaCasePassportsInTransitBy", fields: [passportsInTransitById], references: [id], onDelete: Restrict)
  passportsReceivedBy     User?                  @relation("VisaCasePassportsReceivedBy", fields: [passportsReceivedById], references: [id], onDelete: Restrict)
  evisaSentBy             User?                  @relation("VisaCaseEvisaSentBy", fields: [evisaSentById], references: [id], onDelete: Restrict)
  recallReason            RecallReason?          @relation(fields: [recallReasonId], references: [id], onDelete: Restrict)
  shortfallClearedBy      User?                  @relation("VisaCaseShortfallClearedBy", fields: [shortfallClearedById], references: [id], onDelete: Restrict)
  shortfallReason         MissingPassportReason? @relation(fields: [shortfallReasonId], references: [id], onDelete: Restrict)
  embassy                 Embassy?               @relation(fields: [embassyId], references: [id], onDelete: Restrict)
  vendor                  Vendor?                @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  docket                  Docket?                @relation(fields: [docketId], references: [id], onDelete: Restrict)
  coveringLetterVersion   CoveringLetterVersion? @relation(fields: [coveringLetterVersionId], references: [id], onDelete: Restrict)
  coveringLetterMadeBy    User?                  @relation("VisaCaseCoveringLetterMadeBy", fields: [coveringLetterMadeById], references: [id], onDelete: Restrict)
  travellers              VisaCaseTraveller[]
  quote                   VisaQuote?
  /// Step 8 (0014): the passports handed back to the client; null until then.
  handover                VisaHandover?

  @@index([offeringId])
  @@index([embassyId])
  @@index([vendorId])
  @@index([fileReadyById])
  @@index([docketId])
  @@index([coveringLetterVersionId])
}

/// The embassy's decision on one traveller (docs/decisions/0012-visa-decision.md Decision 2): two outcomes.
enum VisaOutcome {
  APPROVED
  REFUSED
}

/// An approved traveller's visa sticker, checked against the passport's name and the dates recorded at Step 6 when the
/// passports are received (docs/decisions/0013-visa-passport-back.md Decision 5). For an e-visa, its PDF checked against
/// the passport and what was recorded at Step 6 (docs/decisions/0025-evisa-after-decision.md).
enum StickerCheck {
  MATCHES
  MISMATCH
}

/// One person on the case. Created as placeholders at intake ("Adult 1", "Child 1"); named in Step 2 by linking
/// the client's family member (0006 Decision 3), which brings the passport and the consent.
model VisaCaseTraveller {
  id                 String             @id @default(uuid())
  caseId             String
  /// 1, 2, 3… Adults first, then children.
  position           Int
  isChild            Boolean
  /// Passport name, copied from the member when linked: what the case was filed under.
  name               String?
  memberId           String?
  /// From the government portal, typed in at File preparation (0007 Decision 5). Capitals and digits, 4–40 (checked
  /// in the migration).
  ackNo              String?
  /// The portal appointment, entered as a day and a time in India.
  appointmentAt      DateTime?          @db.Timestamptz(3)
  /// The embassy's decision (docs/decisions/0012-visa-decision.md): null until recorded.
  outcome            VisaOutcome?
  /// An approved visa's sticker number (an e-visa's number), and the dates it's valid. All three set for APPROVED and
  /// none otherwise; the number in capitals with single spaces; validTo on or after validFrom (checked in the migration).
  visaNo             String?
  validFrom          DateTime?          @db.Date
  validTo            DateTime?          @db.Date
  /// Checked when the passports are received (0013 Decision 5); an e-visa's, once its PDF is uploaded at Decision, and
  /// cleared by a newer PDF (0025). Only an approved traveller has one (checked in the migration); null until checked.
  stickerCheck       StickerCheck?
  visaCase           VisaCase           @relation(fields: [caseId], references: [enquiryId], onDelete: Restrict)
  member             ClientMember?      @relation(fields: [memberId], references: [id], onDelete: Restrict)
  documents          VisaCaseDocument[]
  quoteLine          VisaQuoteLine?
  invoiceLines       InvoiceLine[]
  /// Scanned refusal letters (0012 Decision 4) and e-visas (0025), the newest of each kind current; kept when the
  /// outcome changes.
  files              CaseFile[]
  /// Handovers where this traveller collected the passports (0014 Decision 3).
  handoversCollected VisaHandover[]

  @@unique([caseId, position])
  @@unique([caseId, memberId])
  @@index([memberId])
  /// A sticker or e-visa number already on another case is a warning (0012, amended 19 Oct 2026).
  @@index([visaNo])
}

/// How the passports went back to the client (docs/decisions/0014-visa-delivered.md): collected at our office, or
/// taken to them by our delivery boy (from component 4).
enum HandoverMode {
  OFFICE
  DELIVERY
}

/// The passports handed back to the client (docs/decisions/0014-visa-delivered.md), once per case, never changed: how,
/// when and by whom; the booklets counted (the service keeps them equal to the stock count, Decision 4); who collected
/// them, a traveller on the case or someone else by name (exactly one); and the photo of that person. At the client's
/// door (mode DELIVERY, 0015 phase 5) it points at the boy's field job, which holds the client's code, his selfie and
/// the place (checked in the migration).
model VisaHandover {
  enquiryId           String             @id
  mode                HandoverMode
  at                  DateTime           @db.Timestamptz(3)
  byId                String
  bookletsCurrent     Int                @db.SmallInt
  bookletsOld         Int                @db.SmallInt
  receiverTravellerId String?
  receiverName        String?
  receiverPhotoId     String             @unique
  /// The delivery boy's job, at the door (mode DELIVERY), and only then.
  fieldJobId          String?            @unique
  visaCase            VisaCase           @relation(fields: [enquiryId], references: [enquiryId], onDelete: Restrict)
  by                  User               @relation("VisaHandoverBy", fields: [byId], references: [id], onDelete: Restrict)
  receiverTraveller   VisaCaseTraveller? @relation(fields: [receiverTravellerId], references: [id], onDelete: Restrict)
  receiverPhoto       CaseFile           @relation(fields: [receiverPhotoId], references: [id], onDelete: Restrict)
  fieldJob            FieldJob?          @relation(fields: [fieldJobId], references: [id], onDelete: Restrict)

  @@index([byId])
  @@index([receiverTravellerId])
}

/// How a consent came to be on file (docs/decisions/0022-consent-form.md, part 3).
enum ConsentSource {
  /// The client tapped "I agree" on the form's link.
  LINK
  /// Signed on paper before the CRM, and marked on file by the Head or the Visa HOD.
  PAPER
}

/// One person's consent & liability form, given once for life; it stays valid if the passport changes (§10.5,
/// docs/decisions/0022-consent-form.md). Until there is one, the case shows "None on file — flagged". A LINK consent
/// keeps what was agreed to, as evidence: the wording, the details as the page showed them, and where the tap came
/// from. A PAPER one keeps the year it was signed and who marked it. Checks in the migration: each source has exactly
/// its own fields; a trigger refuses any change, and any delete but a paper one's (a mistaken mark).
model Consent {
  id         String          @id @default(uuid())
  memberId   String          @unique
  source     ConsentSource   @default(LINK)
  /// When they tapped "I agree"; for a paper consent, when it was marked on file.
  agreedAt   DateTime        @db.Timestamptz(3)
  /// The wording they read and agreed to (LINK).
  wordingId  Int?
  /// The link they agreed through (LINK).
  linkId     String?         @unique
  /// The name, passport number and form details as the page showed them (LINK).
  details    Json?
  /// The phone's network address and browser when they tapped "I agree" (LINK).
  ip         String?
  userAgent  String?
  /// The year it was signed on paper (PAPER).
  paperYear  Int?
  /// Who marked the paper consent on file (PAPER).
  markedById String?
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)
  member     ClientMember    @relation(fields: [memberId], references: [id], onDelete: Restrict)
  wording    ConsentWording? @relation(fields: [wordingId], references: [id], onDelete: Restrict)
  link       ConsentLink?    @relation(fields: [linkId], references: [id], onDelete: Restrict)
  markedBy   User?           @relation("ConsentMarkedBy", fields: [markedById], references: [id], onDelete: Restrict)
}

/// The consent form's wording (0022). Never changed or removed (a trigger), because consents point at it; the newest is
/// the one in use. Seeded with a draft until Masti's (Q9): addedById null marks it. Checks in the migration: no blank
/// body, at most 8000 characters.
model ConsentWording {
  id        Int       @id @default(autoincrement())
  body      String
  addedById String?
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  addedBy   User?     @relation("ConsentWordingAddedBy", fields: [addedById], references: [id], onDelete: Restrict)
  consents  Consent[]
}

/// A link to one person's consent form, sent on WhatsApp (0022). Only the token's SHA-256 is kept. It works until the
/// client agrees through it or "Send the link again" replaces it. Checks in the migration: never both used and replaced,
/// at most one link per person still open, the number's format.
model ConsentLink {
  id          String       @id @default(uuid())
  memberId    String
  /// The case it was sent from.
  enquiryId   String
  tokenHash   String       @unique
  /// Where it went: the person's own number, or the client's main one.
  toMobile    String
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  createdById String
  /// "Send the link again" made a newer one.
  replacedAt  DateTime?    @db.Timestamptz(3)
  /// The client agreed through it.
  usedAt      DateTime?    @db.Timestamptz(3)
  member      ClientMember @relation(fields: [memberId], references: [id], onDelete: Restrict)
  enquiry     Enquiry      @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  createdBy   User         @relation("ConsentLinkCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  consent     Consent?

  @@index([memberId, createdAt])
}

enum DocumentStatus {
  PENDING
  RECEIVED
  /// For ARRANGED_BY_US items.
  MADE
  NOT_NEEDED
}

enum ReceivedAs {
  ORIGINAL
  XEROX
  /// Printed from the copy in the client's document vault (docs/decisions/0016-client-documents.md Decision 5): only
  /// for a paper that may be a xerox, and with the scan it came from (hand-written CHECKs).
  ON_FILE
}

/// The processor's own check of a paper in Step 3 (docs/decisions/0007-visa-file-prep.md Decision 3).
enum DocumentCheck {
  CHECKED
  NEEDS_REPLACING
}

/// How fast the embassy processes the application: "Normal", "Express"… (docs/decisions/0009-visa-invoice.md Decision 6).
/// Picked on the case's quote and printed on the invoice line. Edited by the Visa HOD or the Head.
model ProcessingSpeed {
  id        Int         @id @default(autoincrement())
  /// NORMAL, EXPRESS… Never changes.
  code      String      @unique
  name      String
  sortOrder Int         @default(0)
  isActive  Boolean     @default(true)
  quotes    VisaQuote[]
}

/// How urgent a visa enquiry is: "Normal", "Urgent"… (docs/decisions/0003-visa-intake.md amendment 1, change request
/// 17). Picked on New enquiry and changed on the case. NORMAL is where every enquiry starts, so it is never switched
/// off; every other level is urgent and shows as a red tag. Edited by the Visa HOD or the Head.
model UrgencyLevel {
  id        Int     @id @default(autoincrement())
  /// NORMAL, URGENT… Never changes.
  code      String  @unique
  name      String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
}

/// How a docket goes to the vendor: "Blue Dart", "DTDC", "By hand (no AWB)" (docs/decisions/0008-visa-docket-dispatch.md
/// Decision 6). Picked at dispatch. Edited by the Visa HOD or the Head; switched off, never deleted.
model Courier {
  id        Int      @id @default(autoincrement())
  /// BLUE_DART, BY_HAND… Never changes.
  code      String   @unique
  name      String
  /// Off for "By hand": no slip (AWB) number is asked for.
  awbNeeded Boolean  @default(true)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  dockets   Docket[]
}

/// Why a credit note is issued: "Wrong amount", "Client cancelled", "Recall"… (docs/decisions/0011-visa-at-vendor.md
/// Decision 5). Never free text. Edited by the Visa HOD or the Head; switched off, never deleted.
model CreditNoteReason {
  id          Int          @id @default(autoincrement())
  /// WRONG_AMOUNT, RECALL… Never changes.
  code        String       @unique
  name        String
  sortOrder   Int          @default(0)
  isActive    Boolean      @default(true)
  creditNotes CreditNote[]
}

/// Why a file is taken back from the vendor: "Embassy taking too long", "Client cancelled the trip"…
/// (docs/decisions/0011-visa-at-vendor.md Decision 6). Never free text. Edited by the Visa HOD or the Head; switched off,
/// never deleted.
model RecallReason {
  id        Int        @id @default(autoincrement())
  /// EMBASSY_DELAY… Never changes.
  code      String     @unique
  name      String
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  visaCases VisaCase[]
}

/// Why fewer passports came back than went out, when the shortfall is cleared rather than found: "Embassy kept it",
/// "Counted wrong at intake"… (docs/decisions/0013-visa-passport-back.md Decision 5, amended 17 Oct 2026). Never free
/// text. Edited by the Visa HOD or the Head; switched off, never deleted.
model MissingPassportReason {
  id        Int        @id @default(autoincrement())
  /// EMBASSY_KEPT… Never changes.
  code      String     @unique
  name      String
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  visaCases VisaCase[]
}

/// What an additional invoice charges for: "Urgent submission", "Photos"… (docs/decisions/0011-visa-at-vendor.md
/// Decision 7). Picked, with the amount typed; never free text. Edited by the Visa HOD or the Head; switched off, never
/// deleted.
model ExtraCharge {
  id             Int             @id @default(autoincrement())
  /// URGENT_SUBMISSION… Never changes.
  code           String          @unique
  name           String
  sortOrder      Int             @default(0)
  isActive       Boolean         @default(true)
  invoiceCharges InvoiceCharge[]
}

/// Why a paper needs replacing: "Not signed", "Wrong photo size"… Edited by the Visa HOD or the Head.
model DocumentProblemReason {
  id        Int                @id @default(autoincrement())
  /// NOT_SIGNED, EXPIRED… Never changes.
  code      String             @unique
  name      String
  sortOrder Int                @default(0)
  isActive  Boolean            @default(true)
  documents VisaCaseDocument[]
}

/// A traveller's copy of a checklist line. The name, detail, requirement, quantity and note are copied,
/// so editing the master never changes an open case.
model VisaCaseDocument {
  id               String                 @id @default(uuid())
  travellerId      String
  /// Kept for reports ("which document is pending most often").
  documentId       Int
  name             String
  detail           String?
  requirement      DocumentRequirement
  quantity         Int                    @default(1) @db.SmallInt
  note             String?
  sortOrder        Int
  status           DocumentStatus         @default(PENDING)
  // Filled in Step 2, when the paper is scanned in the office:
  receivedAs       ReceivedAs?
  receivedAt       DateTime?              @db.Timestamptz(3)
  receivedById     String?
  /// The scan in the client's vault an ON_FILE paper came from (set exactly for ON_FILE: hand-written CHECK).
  clientDocumentId String?
  // Filled in Step 3, when the processor checks the paper. A reason exactly when it needs replacing (hand-written CHECKs).
  check            DocumentCheck?
  checkReasonId    Int?
  checkedAt        DateTime?              @db.Timestamptz(3)
  checkedById      String?
  traveller        VisaCaseTraveller      @relation(fields: [travellerId], references: [id], onDelete: Restrict)
  document         DocumentMaster         @relation(fields: [documentId], references: [id], onDelete: Restrict)
  receivedBy       User?                  @relation("DocumentReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  checkReason      DocumentProblemReason? @relation(fields: [checkReasonId], references: [id], onDelete: Restrict)
  checkedBy        User?                  @relation("DocumentCheckedBy", fields: [checkedById], references: [id], onDelete: Restrict)
  clientDocument   ClientDocument?        @relation(fields: [clientDocumentId], references: [id], onDelete: Restrict)

  @@unique([travellerId, documentId])
  @@index([documentId, status])
  @@index([clientDocumentId])
}

// ---------------------------------------------------------------------------
// System settings (small key/value config edited by the Head)
// ---------------------------------------------------------------------------

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

// ---------------------------------------------------------------------------
// The quote (docs/decisions/0009-visa-invoice.md Decision 2): every amount the visa invoice will print. Money is in
// paise, as integers. Editable until the invoice is raised.
// ---------------------------------------------------------------------------

/// A traveller's amount: one lump sum, or the embassy fee, VFS fee and other, itemised.
enum QuoteForm {
  LUMP_SUM
  ITEMISED
}

/// One per visa case. Hand-written in the migration: the service charge is 0–10,00,00,000 paise.
model VisaQuote {
  enquiryId          String          @id
  processingSpeedId  Int
  /// Masti's own service (processing) charge for the case: the only part GST applies to (0009 Decision 3).
  serviceChargePaise Int             @default(0)
  updatedById        String
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)
  /// The quote's own optimistic-lock token: two people editing one quote can't overwrite each other.
  updatedAt          DateTime        @updatedAt @db.Timestamptz(3)
  visaCase           VisaCase        @relation(fields: [enquiryId], references: [enquiryId], onDelete: Restrict)
  processingSpeed    ProcessingSpeed @relation(fields: [processingSpeedId], references: [id], onDelete: Restrict)
  updatedBy          User            @relation("VisaQuoteUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  lines              VisaQuoteLine[]

  @@index([processingSpeedId])
  @@index([updatedById])
}

/// One per traveller. Hand-written in the migration: the amounts match the form, and each is 0–10,00,00,000 paise.
model VisaQuoteLine {
  travellerId     String            @id
  enquiryId       String
  form            QuoteForm
  lumpSumPaise    Int?
  embassyFeePaise Int?
  vfsFeePaise     Int?
  otherFeePaise   Int?
  traveller       VisaCaseTraveller @relation(fields: [travellerId], references: [id], onDelete: Restrict)
  quote           VisaQuote         @relation(fields: [enquiryId], references: [enquiryId], onDelete: Cascade)

  @@index([enquiryId])
}

// ---------------------------------------------------------------------------
// Masti's logo and signature, printed on every invoice (docs/decisions/0009-visa-invoice.md Decision 8). Stored privately
// in the document bucket. The newest of each kind is the current one; older ones are kept, never deleted.
// ---------------------------------------------------------------------------

enum CompanyImageKind {
  LOGO
  SIGNATURE
}

model CompanyImage {
  id           String           @id @default(uuid())
  kind         CompanyImageKind
  /// company/<kind>/<uuid>.png|jpg in the bucket.
  storageKey   String           @unique
  /// image/png or image/jpeg.
  contentType  String
  sizeBytes    Int
  uploadedById String
  uploadedAt   DateTime         @default(now()) @db.Timestamptz(3)
  uploadedBy   User             @relation("CompanyImageUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([kind, uploadedAt])
  @@index([uploadedById])
}

// ---------------------------------------------------------------------------
// The visa tax invoice (docs/decisions/0009-visa-invoice.md): copied from the case's quote and never edited. Triggers in
// the migration refuse any UPDATE or DELETE of an invoice or its lines; corrections come with Step 5 (credit note,
// the one additional invoice).
// ---------------------------------------------------------------------------

/**
 * CGST + SGST when the client is in Masti's state (place of supply), IGST otherwise (0009 Decision 3).
 */
enum InvoiceTaxType {
  INTRA_STATE
  INTER_STATE
}

/// Hand-written in the migration: the totals add up, the tax matches the type, amounts are never negative, and the
/// row can't be changed or deleted.
/// The case's tax invoice, or the one additional invoice for extra charges (docs/decisions/0011-visa-at-vendor.md Decision 7).
enum InvoiceKind {
  MAIN
  ADDITIONAL
}

model Invoice {
  id                 String          @id @default(uuid())
  /// MAIN: raised from the quote, with traveller lines. ADDITIONAL: "MVI…-A", extra charges, no GST (checked in the
  /// migration). One original of each per case.
  kind               InvoiceKind     @default(MAIN)
  /// "MVI00001379": Masti's own series continues (0009 Decision 4).
  invoiceNo          String          @unique
  /// The case. One original invoice per case (0009 Decision 6); a cancelled one can be replaced, each replacement
  /// pointing at the one it replaces (docs/decisions/0011-visa-at-vendor.md Decision 5). Checked in the migration.
  enquiryId          String
  /// The cancelled invoice this one replaces, if it's a replacement.
  replacesId         String?         @unique
  /// The date printed on it (IST).
  issuedOn           DateTime        @db.Date
  issuedAt           DateTime        @default(now()) @db.Timestamptz(3)
  /// "Prepared by".
  issuedById         String
  /// Snapshots at raise time, so a later edit to the client, Masti's details or the terms never changes an invoice.
  client             Json
  company            Json
  terms              Json
  /// The client's GST state code.
  placeOfSupply      String          @db.Char(2)
  taxType            InvoiceTaxType
  sac                String
  /// 1800 = 18%.
  gstRateBp          Int
  processingSpeed    String
  /// The travellers' amounts together (passed on, no GST).
  grossPaise         Int
  serviceChargePaise Int
  cgstPaise          Int
  sgstPaise          Int
  igstPaise          Int
  totalPaise         Int
  /// The PDF as raised.
  fileId             String          @unique
  enquiry            Enquiry         @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  replaces           Invoice?        @relation("InvoiceReplaces", fields: [replacesId], references: [id], onDelete: Restrict)
  replacedBy         Invoice?        @relation("InvoiceReplaces")
  issuedBy           User            @relation("InvoiceIssuedBy", fields: [issuedById], references: [id], onDelete: Restrict)
  file               CaseFile        @relation(fields: [fileId], references: [id], onDelete: Restrict)
  lines              InvoiceLine[]
  charges            InvoiceCharge[]
  creditNotes        CreditNote[]

  @@index([enquiryId])
  @@index([issuedById])
}

/// One traveller on the invoice, copied from the quote. Hand-written: the amounts match the form; can't be changed.
model InvoiceLine {
  invoiceId       String
  /// 1, 2, 3… (printed 001, 002…).
  position        Int
  travellerId     String
  name            String
  /// "FRANCE(TOURIST)(NORMAL)(SINGLE)": country, visa type, processing speed, entry.
  description     String
  form            QuoteForm
  lumpSumPaise    Int?
  embassyFeePaise Int?
  vfsFeePaise     Int?
  otherFeePaise   Int?
  totalPaise      Int
  invoice         Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  traveller       VisaCaseTraveller @relation(fields: [travellerId], references: [id], onDelete: Restrict)

  @@id([invoiceId, position])
  @@index([travellerId])
}

/// Whole: cancels an invoice outright, a correction. Part: gives back some of it, a recall (docs/decisions/0011-visa-at-vendor.md
/// Decisions 5 and 6).
enum CreditNoteKind {
  WHOLE
  PART
}

/// A credit note against one invoice (docs/decisions/0011-visa-at-vendor.md Decision 5), in its own number series. Never
/// edited (a trigger). Hand-written in the migration: the totals add up, nothing is negative, a WHOLE one gives back
/// exactly what its invoice charged (GST included) and is the invoice's only one, a PART one carries no GST.
model CreditNote {
  id                 String           @id @default(uuid())
  /// "MCN00000001"
  creditNoteNo       String           @unique
  invoiceId          String
  /// The invoice's case (checked in the migration), for the case page and reports.
  enquiryId          String
  kind               CreditNoteKind
  reasonId           Int
  /// The date printed on it (IST).
  issuedOn           DateTime         @db.Date
  issuedAt           DateTime         @default(now()) @db.Timestamptz(3)
  issuedById         String
  /// The client as the invoice printed them, and Masti's details now.
  client             Json
  company            Json
  grossPaise         Int
  serviceChargePaise Int
  cgstPaise          Int
  sgstPaise          Int
  igstPaise          Int
  totalPaise         Int
  /// The PDF as issued.
  fileId             String           @unique
  invoice            Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  enquiry            Enquiry          @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  reason             CreditNoteReason @relation(fields: [reasonId], references: [id], onDelete: Restrict)
  issuedBy           User             @relation("CreditNoteIssuedBy", fields: [issuedById], references: [id], onDelete: Restrict)
  file               CaseFile         @relation(fields: [fileId], references: [id], onDelete: Restrict)
  lines              CreditNoteLine[]

  @@index([invoiceId])
  @@index([enquiryId])
  @@index([issuedById])
}

/// One traveller's amounts given back, from the invoice's line `invoicePosition`. Can't be changed.
model CreditNoteLine {
  creditNoteId    String
  /// 1, 2, 3… (printed 001, 002…).
  position        Int
  invoicePosition Int
  name            String
  description     String
  form            QuoteForm
  lumpSumPaise    Int?
  embassyFeePaise Int?
  vfsFeePaise     Int?
  otherFeePaise   Int?
  totalPaise      Int
  creditNote      CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Restrict)

  @@id([creditNoteId, position])
}

/// The last credit-note number used: one row (id 1), bumped in the credit note's own transaction.
model CreditNoteCounter {
  id        Int @id @default(1)
  lastValue Int
}

/// One extra charge on an ADDITIONAL invoice (docs/decisions/0011-visa-at-vendor.md Decision 7): picked from the list,
/// with its amount. Can't be changed, and only on an ADDITIONAL invoice (both in the migration).
model InvoiceCharge {
  invoiceId   String
  /// 1, 2, 3…
  position    Int
  chargeId    Int
  /// The charge's name as printed.
  name        String
  amountPaise Int
  invoice     Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  charge      ExtraCharge @relation(fields: [chargeId], references: [id], onDelete: Restrict)

  @@id([invoiceId, position])
  @@index([chargeId])
}

/// The last invoice number used: one row (id 1), bumped in the invoice's own transaction.
model InvoiceCounter {
  id        Int @id @default(1)
  lastValue Int
}

// ---------------------------------------------------------------------------
// Messages to clients (docs/decisions/0021-whatsapp-outbox.md): a transactional outbox. A message is written in the
// transaction of the change it reports, and the pg-boss job "whatsapp-send" sends it afterwards.
// ---------------------------------------------------------------------------

/// Code branches on it.
enum MessageStatus {
  /// Waiting for the sender, or for its next try.
  QUEUED
  /// Handed to the provider, not confirmed delivered yet.
  SENT
  DELIVERED
  READ
  /// It didn't go, or the provider reported it undelivered: `error` says why.
  FAILED
  /// Not sent on purpose: its template is switched off.
  SKIPPED
}

/// The wording of one automatic message (docs/whatsapp-visa-messages.md): seeded, the words still Masti's to approve
/// (M1). Checks in the migration: no blank name or body.
model MessageTemplate {
  id                 Int               @id @default(autoincrement())
  /// "visa.documents_received": the code queues messages by it. Never changes.
  code               String            @unique
  /// "All documents received"
  name               String
  /// The words, with {{placeholders}} such as {{client_name}}, {{visa}} and {{case_no}}.
  body               String
  /// The provider's id for the Meta-approved version (Twilio: its Content SID, "HX…"). Empty until approved: the body
  /// then goes as written, which WhatsApp delivers only within 24 hours of the client's last message to us.
  providerTemplateId String?
  /// Switched off: its messages are still written down, but never sent (SKIPPED).
  isActive           Boolean           @default(true)
  messages           OutboundMessage[]
}

/// One message to a client, and the record of what they were told. Its id is also its pg-boss job's id.
/// Checks in the migration: one that went (SENT, DELIVERED, READ) has sentAt, provider, providerMessageId and sentTo,
/// plus deliveredAt or readAt for those two; a FAILED one has error and failedAt; sendingAt only while QUEUED;
/// attempts never negative; no blank body; the number's format; a file link's key and expiry together, and only with a
/// file.
model OutboundMessage {
  id                     String          @id @default(uuid())
  templateId             Int
  clientId               String
  /// The case it's about, when there is one.
  enquiryId              String?
  /// The client's main number when it was queued: who it is for.
  toMobile               String
  /// The values put into the template's placeholders.
  variables              Json
  /// The words as rendered when it was queued.
  body                   String
  /// "visa.documents_received:<enquiryId>": the same event never queues a second message.
  idempotencyKey         String          @unique
  status                 MessageStatus   @default(QUEUED)
  /// Tries so far.
  attempts               Int             @default(0)
  /// Set while a try is with the provider. A try that never came back isn't repeated: the message may have gone.
  sendingAt              DateTime?       @db.Timestamptz(3)
  /// Who carried it ("twilio", "log") and their id for it, which delivery updates refer to.
  provider               String?
  providerMessageId      String?
  /// The number it went to: outside production, always WHATSAPP_TEST_NUMBER.
  sentTo                 String?
  /// Why the last try failed, or why it wasn't delivered, in plain words.
  error                  String?
  createdAt              DateTime        @default(now()) @db.Timestamptz(3)
  sentAt                 DateTime?       @db.Timestamptz(3)
  deliveredAt            DateTime?       @db.Timestamptz(3)
  readAt                 DateTime?       @db.Timestamptz(3)
  failedAt               DateTime?       @db.Timestamptz(3)
  updatedAt              DateTime        @updatedAt @db.Timestamptz(3)
  /// A file sent with the words (docs/decisions/0025-evisa-after-decision.md, part 2): one of the case's files, which
  /// the provider fetches through the CRM's own short-lived link (messageFiles.public.routes.ts). One per message, as
  /// WhatsApp takes one.
  attachmentId           String?
  /// The SHA-256 of the file link's key, made afresh at each try (an earlier try's link stops working), and when the
  /// link stops working.
  attachmentKeyHash      String?         @unique
  attachmentKeyExpiresAt DateTime?       @db.Timestamptz(3)
  template               MessageTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  client                 Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  enquiry                Enquiry?        @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  attachment             CaseFile?       @relation(fields: [attachmentId], references: [id], onDelete: Restrict)

  @@index([clientId, createdAt])
  @@index([enquiryId, createdAt])
}

// ---------------------------------------------------------------------------
// AI (docs/decisions/0023-ai.md): every call goes through src/lib/ai's askAi(), which writes it down here with its
// tokens and cost, whatever the outcome.
// ---------------------------------------------------------------------------

/// How one AI call ended.
enum AiCallStatus {
  /// It answered.
  OK
  /// No usable answer: `error` says why. A cut-off answer was still billed, so it keeps its tokens.
  FAILED
  /// The AI declined to answer. Billed, so it keeps its tokens.
  REFUSED
}

/// One call to the AI and what it cost. The prompt and the reply aren't kept: they hold client details.
/// Checks in the migration: no blank use case, provider, model or error; no negative number; tokens in and out
/// together, and a cost only with them; OK and REFUSED have tokens; OK has no error, FAILED and REFUSED have one.
model AiCall {
  id           String       @id @default(uuid())
  /// What it was for: a code from src/lib/ai/useCases.ts, e.g. "ai.test".
  useCase      String
  /// Who answered ("anthropic", "fake"), or the AI_PROVIDER setting when no one could.
  provider     String
  /// The model that answered, or the AI_MODEL setting when none did.
  model        String
  status       AiCallStatus
  inputTokens  Int?
  outputTokens Int?
  /// In micro-dollars ($0.000001), from src/lib/ai/prices.ts. Empty without tokens, or for a model with no price there.
  costMicroUsd Int?
  durationMs   Int
  /// Why it failed or was refused, in plain words.
  error        String?
  /// Who asked, when a person did.
  userId       String?
  /// The case it was for, when there is one.
  enquiryId    String?
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  user         User?        @relation("AiCallBy", fields: [userId], references: [id], onDelete: Restrict)
  enquiry      Enquiry?     @relation(fields: [enquiryId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([enquiryId, createdAt])
}

// ---------------------------------------------------------------------------
// Portal logins: "Log in for me" (docs/decisions/0024-portal-logins.md, demo screen 28)
// ---------------------------------------------------------------------------

enum PortalLoginStatus {
  /// In use.
  ACTIVE
  /// Taken off the list. Its saved ID and password are wiped; the row stays for the record.
  REMOVED
}

/// What happened after a press of "Log in for me" (0024). The CRM helper reports all but REFUSED, which the server sets.
enum PortalLoginOutcome {
  /// The helper filled the boxes and pressed the portal's login button (whether the portal accepted it isn't known).
  SUBMITTED
  /// The helper filled the boxes and left the letters to type (a captcha) to the staff member.
  WAITING_FOR_STAFF
  /// The helper found nowhere to log in on the page.
  NO_LOGIN_BOXES
  /// The portal opened on another address, so nothing was typed.
  ADDRESS_CHANGED
  /// The page never finished opening.
  DIDNT_OPEN
  /// The server refused to hand the login over (switched off, taken off the list, outside the office…).
  REFUSED
  /// Anything else.
  FAILED
}

/// How often a portal's password has to be changed (0024 component 2). From the start of the due date (India time) the
/// portal is locked for everyone until an HOD types a new password.
enum PortalPasswordSchedule {
  /// The day after the last change.
  DAILY
  /// 7 days after.
  WEEKLY
  /// The same date the next month (31 Jan → 28 Feb).
  MONTHLY
  /// No scheduled change: it never locks.
  NONE
}

/// A company account on a visa, airline or supplier portal (demo screen 28). Staff press "Log in for me" and never see the
/// ID or password; the Head and the department's HOD add, change and remove it.
/// Checks in the migration: name and ID label not blank and not too long; the address http(s); the secret kept exactly
/// while ACTIVE; one active name per department, whatever the case.
model PortalLogin {
  /// Made by the server before saving: the secret is sealed with it ("portal-login:<id>").
  id                String                 @id
  /// Fixed once added.
  departmentId      Int
  /// "France visa portal"
  name              String
  /// The portal's login page.
  loginUrl          String
  /// What the portal calls the first box: "ID", "User ID", "Agency code".
  idLabel           String                 @default("ID")
  /// What a third login box is called ("Agency code"), for portals with one before the ID and password; null when the
  /// portal has only the two. Its value rides in `secret`, never in its own column (0024).
  extraLabel        String?
  /// The ID and password (and the extra box's value when `extraLabel` is set), sealed by src/lib/secretBox.ts under
  /// PORTAL_VAULT_KEY. Null once removed.
  secret            Bytes?
  /// What to do on this portal once it's open ("Fill the application form", "Enter the acknowledgement number"), shown
  /// by the helper in the portal's tab. Admin-editable; empty for none (0024).
  steps             String[]               @default([])
  /// When the password was last saved: on adding, or when an HOD typed a new one. The schedule counts from it.
  passwordChangedAt DateTime               @db.Timestamptz(3)
  /// How often the password has to change (component 2); Masti changes monthly.
  passwordSchedule  PortalPasswordSchedule @default(MONTHLY)
  status            PortalLoginStatus      @default(ACTIVE)
  createdById       String
  createdAt         DateTime               @default(now()) @db.Timestamptz(3)
  /// Also the optimistic-lock token for PATCH; moves on every change, the list of people included.
  updatedAt         DateTime               @updatedAt @db.Timestamptz(3)
  department        Department             @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  createdBy         User                   @relation("PortalLoginCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  users             PortalLoginUser[]
  uses              PortalLoginUse[]
  /// The visas whose cases open this portal (component 3).
  visaOfferings     VisaOffering[]

  @@index([departmentId, status])
}

/// Who may press "Log in for me" on a portal, besides the Head and the department's HOD.
model PortalLoginUser {
  portalLoginId String
  userId        String
  portalLogin   PortalLogin @relation(fields: [portalLoginId], references: [id], onDelete: Cascade)
  user          User        @relation("PortalLoginUsers", fields: [userId], references: [id], onDelete: Cascade)

  @@id([portalLoginId, userId])
  @@index([userId])
}

/// One press of "Log in for me" (0024): a one-time ticket for the CRM helper, then whether the helper collected the
/// login and what it said happened. "Who used what" reads the collected ones.
/// Checks in the migration: the ticket expires after it's made; a collected ticket's hash is gone; an outcome has its time.
model PortalLoginUse {
  id              String              @id @default(uuid())
  portalLoginId   String
  userId          String
  /// Where the button was pressed from.
  openedIp        String?
  /// sha256 of the ticket while it can still be collected; cleared once it has been, or refused.
  ticketHash      String?             @unique
  ticketExpiresAt DateTime            @db.Timestamptz(3)
  /// When the helper collected the ID and password, and from where.
  redeemedAt      DateTime?           @db.Timestamptz(3)
  redeemedIp      String?
  outcome         PortalLoginOutcome?
  outcomeAt       DateTime?           @db.Timestamptz(3)
  /// The case it was pressed on (component 3); null when pressed on Settings → Portal logins.
  enquiryId       String?
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  portalLogin     PortalLogin         @relation(fields: [portalLoginId], references: [id], onDelete: Restrict)
  user            User                @relation("PortalLoginUsedBy", fields: [userId], references: [id], onDelete: Restrict)
  enquiry         Enquiry?            @relation(fields: [enquiryId], references: [id], onDelete: Restrict)

  @@index([portalLoginId, redeemedAt])
  @@index([redeemedAt])
  @@index([userId])
  @@index([enquiryId])
}
