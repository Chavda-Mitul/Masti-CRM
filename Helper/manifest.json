{
  "manifest_version": 3,
  "name": "Masti CRM helper",
  "version": "0.1.0",
  "description": "Types Masti's saved portal logins when you press Log in for me in the Masti CRM.",
  "minimum_chrome_version": "120",
  "key": "",
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["scripting", "privacy", "management", "storage"],
  "action": { "default_popup": "popup.html", "default_title": "Masti CRM helper" },
  "host_permissions": ["https://*/*", "http://*/*"],
  "externally_connectable": {
    "matches": ["http://localhost/*", "http://127.0.0.1/*", "http://portal.localhost/*"]
  }
}
